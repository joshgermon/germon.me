{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "germon-me",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Previews and each preview's URL hang off workers.dev.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
  },
  // germon.me is served by this Worker once the zone is on Cloudflare (see README → Deploying).
  // "routes": [{ "pattern": "germon.me", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
  },
}
