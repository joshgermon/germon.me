{
  "name": "germon.me",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "postinstall": "wrangler types",
    "types": "wrangler types",
    "og": "astro build && node scripts/og.ts",
    "check": "pnpm run types && pnpm run check:astro && pnpm run check:svelte && pnpm run lint && pnpm run test",
    "check:astro": "astro check --minimumFailingSeverity warning",
    "check:svelte": "svelte-check --threshold warning --fail-on-warnings",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt . && prettier --write \"**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"**/*.astro\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "nanostores": "^1",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.85.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vitest": "5.0.1",
    "wrangler": "^4.139.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "printWidth": 100,
    "singleQuote": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
