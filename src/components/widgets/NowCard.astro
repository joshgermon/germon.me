---
/**
 * Now: a /now page as a widget — what Josh is building, learning and shooting. Static.
 */
import Card from '~/components/ui/Card.astro';
import Icon from '~/components/ui/Icon.astro';
import type { IconName } from '~/components/ui/icons';
import { profile } from '~/site/profile';

interface Props {
  class?: string | undefined;
}
const { class: cls } = Astro.props;

const items: ReadonlyArray<{ label: string; icon: IconName; value: string }> = [
  { label: 'Building', icon: 'hammer', value: profile.now.building },
  { label: 'Learning', icon: 'book', value: profile.now.learning },
  { label: 'Shooting', icon: 'camera', value: profile.now.shooting },
];
// The page is rebuilt whenever this changes, so the build month is when it was last true.
const asOf = new Date().toLocaleDateString('en-AU', {
  timeZone: profile.timeZone,
  month: 'short',
  year: 'numeric',
});
---

<Card id="now" title="Now" icon="sparkles" meta={asOf} class={cls}>
  <dl class="grid content-start gap-3.5">
    {items.map((item) => (
      <div>
        <dt class="flex items-center gap-1.5 text-label text-fg-subtle">
          <Icon name={item.icon} size={12} />
          {item.label}
        </dt>
        <dd class="mt-0.75 text-body leading-snug text-pretty text-fg">{item.value}</dd>
      </div>
    ))}
  </dl>
</Card>
