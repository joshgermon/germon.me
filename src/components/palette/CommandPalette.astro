---
/**
 * The ⌘K command palette. Its command registry is built at build time (notes, the GitHub
 * snapshot) and published as a versioned JSON file, which the island fetches when it hydrates,
 * so the page's HTML doesn't carry it. The closed palette costs the page no markup. Hydrated
 * when idle; until then the top-bar pill still sets `$palette`, which the island honours as
 * soon as it mounts.
 */
import { getImage } from 'astro:assets';

import memoji from '~/assets/memoji.jpg';
import { loadPaletteData, palettePath } from './palette-data';
import PaletteIsland from './PaletteIsland.svelte';

const { version } = await loadPaletteData();
const avatar = await getImage({ src: memoji, width: 36, height: 36, format: 'webp' });
---

<PaletteIsland client:idle src={palettePath(version)} avatar={avatar.src} />
