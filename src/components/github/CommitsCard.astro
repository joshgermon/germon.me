---
/**
 * Commits widget: a year of contributions as a stock-style cumulative line. Prerendered from
 * the build-time snapshot, then swapped for the edge-cached live render once the page loads
 * (see GitHubLive.astro and docs/adr/0001).
 */
import { loadActivitySnapshot } from '~/adapters/github/composition-root';
import CommitsView from './CommitsView.astro';
import GitHubLive from './GitHubLive.astro';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
const snapshot = await loadActivitySnapshot();
const activity = snapshot._tag === 'ok' ? snapshot.value.activity : undefined;
// `astro dev` renders the snapshot only: no edge cache there, so a live island would call
// GitHub on every reload. `pnpm preview` and production run the island (docs/adr/0001).
const live = !import.meta.env.DEV;
---

{live ? (
  <GitHubLive server:defer widget="commits" class={cls}>
    <CommitsView slot="fallback" activity={activity} class={cls} />
  </GitHubLive>
) : (
  <CommitsView activity={activity} class={cls} />
)}
