---
/**
 * A GitHub widget (projects, commits or contributions). Prerendered from the build-time
 * snapshot, then swapped for the edge-cached live render once the page loads (see
 * GitHubLive.astro and docs/adr/0001).
 */
import { loadActivitySnapshot } from '~/adapters/github/composition-root';
import GitHubLive from './GitHubLive.astro';
import GitHubView from './GitHubView.astro';
import type { GitHubWidget } from './github-widget';

interface Props {
  widget: GitHubWidget;
  class?: string | undefined;
}
const { widget, class: cls } = Astro.props;
const snapshot = await loadActivitySnapshot();
const activity = snapshot._tag === 'ok' ? snapshot.value.activity : undefined;
// `astro dev` renders the snapshot only: no edge cache there, so a live island would call
// GitHub on every reload. `pnpm preview` and production run the island (docs/adr/0001).
const live = !import.meta.env.DEV;
---

{live ? (
  <GitHubLive server:defer {widget} class={cls}>
    <GitHubView slot="fallback" {widget} {activity} class={cls} />
  </GitHubLive>
) : (
  <GitHubView {widget} {activity} class={cls} />
)}
