---
import Icon, { type IconName } from './Icon.astro';
interface Props {
  items: { label: string; href: string; icon: IconName }[];
  /** `adaptive`: side rail on wide screens (≥900px), bottom bar on phones. */
  orient?: 'bottom' | 'side' | 'adaptive';
  class?: string;
  spy?: boolean;
}
const { items, orient = 'bottom', class: cls, spy = true } = Astro.props;
---
<nav
  class:list={['ltb', cls]}
  data-orient={orient === 'adaptive' ? 'bottom' : orient}
  data-adaptive={orient === 'adaptive' ? '' : undefined}
  data-spy={spy ? 'on' : 'off'}
  aria-label="Sections"
>
  <liquid-glass class="ltb-bar" radius="pill" bezel="18" refraction="26" blur="3">
    <div class="ltb-items">
      {items.map((it, i) => (
        <a class="ltb-item" href={it.href} aria-current={i === 0 ? 'page' : undefined}>
          <Icon name={it.icon} />
          <span>{it.label}</span>
        </a>
      ))}
    </div>
    <liquid-glass class="ltb-drop" radius="pill" bezel="14" refraction="18" dispersion="0.3" static></liquid-glass>
  </liquid-glass>
</nav>
<script>
  import { defineLiquidGlass, mountTabBar } from '@/lib/glass';
  defineLiquidGlass();
  // Adaptive bars pick their orientation before mounting, and follow the viewport after.
  const wide = matchMedia('(min-width: 900px)');
  const orient = () =>
    document.querySelectorAll<HTMLElement>('.ltb[data-adaptive]').forEach((n) => (n.dataset.orient = wide.matches ? 'side' : 'bottom'));
  orient();
  wide.addEventListener('change', orient);
  document.querySelectorAll<HTMLElement>('.ltb').forEach(mountTabBar);
</script>
