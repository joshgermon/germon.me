---
import '@/lib/glass/glass.css';
import '@/lib/glass/tabbar.css';
interface Props { title?: string; description?: string; theme?: 'light' | 'dark'; class?: string }
const {
  title = 'Joshua Germon — Staff Software Engineer',
  description = 'Staff engineer in Sydney. Systems, platforms, photography and notes.',
  theme = 'dark',
  class: cls,
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === 'dark' ? '#000' : '#f2f2f7'} />
    <link rel="icon" href="/favicon.png" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class={cls}>
    <slot />
    <script>
      import { defineLiquidGlass } from '@/lib/glass';
      defineLiquidGlass();
    </script>
  </body>
</html>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  body {
    margin: 0;
    font: 400 1rem/1.5 system-ui, -apple-system, 'SF Pro Text', 'Inter Tight Variable', sans-serif;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }
  img { display: block; max-width: 100%; }
  :focus-visible { outline: 2px solid #0a84ff; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }
  }
</style>
