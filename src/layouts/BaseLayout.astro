---
/**
 * The document shell: metadata, self-hosted fonts, global styles. Pages pass their title,
 * description and kind (`site/seo.ts`); link previews, structured data and icons are shared.
 */
import { Font, getImage } from 'astro:assets';

import memoji from '~/assets/memoji.jpg';
import { openGraphType, shareCard, structuredData, xHandle, type PageKind } from '~/site/seo';
import { profile } from '~/site/profile';

import '~/styles/global.css';

interface Props {
  title: string;
  description: string;
  kind?: PageKind;
  /** `noindex` keeps a page out of search results (it's also left out of the sitemap). */
  robots?: 'index' | 'noindex';
}
const { title, description, kind = { _tag: 'Page' }, robots = 'index' } = Astro.props;
const site = Astro.site ?? new URL('https://germon.me');
const canonical = new URL(Astro.url.pathname, site);
const absolute = (path: string): string => new URL(path, site).href;
const jsonLd = structuredData(kind, canonical, site);
const touchIcon = await getImage({ src: memoji, width: 180, height: 180, format: 'png' });
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {robots === 'noindex' && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#07080a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:type" content={openGraphType(kind)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(shareCard.image)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(shareCard.width)} />
    <meta property="og:image:height" content={String(shareCard.height)} />
    <meta property="og:image:alt" content={shareCard.alt} />
    <meta property="og:video" content={absolute(shareCard.video)} />
    <meta property="og:video:secure_url" content={absolute(shareCard.video)} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content={String(shareCard.width)} />
    <meta property="og:video:height" content={String(shareCard.height)} />
    {kind._tag === 'Article' && (
      <meta property="article:published_time" content={kind.published.toISOString()} />
    )}
    {kind._tag === 'Profile' && <meta property="profile:first_name" content={profile.short} />}
    {kind._tag === 'Profile' && <meta property="profile:last_name" content="Germon" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={xHandle} />
    <meta name="twitter:creator" content={xHandle} />
    <meta name="twitter:image:alt" content={shareCard.alt} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <Font cssVariable="--font-inter" preload />
    <!-- Only the hero's italic pills need the serif above the fold; the upright face swaps in. -->
    <Font cssVariable="--font-newsreader" preload={[{ style: 'italic' }]} />
    <Font cssVariable="--font-geist-mono" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
