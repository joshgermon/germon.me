---
/**
 * Ground stop (src/experiments/ground-stop). This route only arranges: the observed day is read
 * at build time for the sentence and moments (so their numbers match the globe), and the island
 * fetches the same file to draw, then polls live.json and live.bin for the recorded live sky.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { gunzipSync } from 'node:zlib';

import GroundStop from '~/experiments/ground-stop/components/GroundStop.svelte';
import { statsOf } from '~/experiments/ground-stop/domain/day-stats';
import { decode } from '~/experiments/ground-stop/domain/observed-codec';
import { experiment } from '~/experiments/ground-stop/experiment';
import { moments, sentence } from '~/experiments/ground-stop/site/moments';
import ExperimentLayout from '~/experiments/kit/ExperimentLayout.astro';

import '~/experiments/ground-stop/styles/global.css';

const DATA = '/experiments/ground-stop/observed.bin.gz';
const decoded = decode(gunzipSync(readFileSync(join(process.cwd(), 'public', DATA))));
if (decoded._tag === 'Err') {
  throw new Error(
    `ground-stop data: ${decoded.error._tag}. Run \`pnpm tsx scripts/experiments/ground-stop/bake.ts\`.`,
  );
}
const stats = statsOf(decoded.value);
---

<ExperimentLayout {experiment}>
  <GroundStop
    client:load
    moments={moments(stats)}
    segments={sentence(stats)}
    window={decoded.value.window}
    dataUrl={DATA}
    liveUrl="/experiments/ground-stop/live.json"
    liveTracksUrl="/experiments/ground-stop/live.bin"
  />
</ExperimentLayout>
