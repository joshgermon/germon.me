---
/**
 * Scrapbook / Desk — a top-down, near-photoreal walnut desk with a wool felt
 * mat. Everything on it is a real object: a letterhead, a letterpress card,
 * matte prints, a Swiss CV under a brass clip, index cards, typed notes.
 * One glass paperweight is the hero; the tab bar is the only other glass.
 */
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter/opsz.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@/concepts/scrapbook-desk/desk.css';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import TabBar from '@/components/TabBar.astro';
import { profile, career, stats, projects, photos } from '@/data/profile';
import { woodSvg, feltSvg, paperSvg, clothSvg, svgUrl } from '@/concepts/scrapbook-desk/textures';

const allNotes = (await getCollection('notes')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const notes = allNotes.slice(0, 6).map((n, i) => {
  const para =
    (n.body ?? '')
      .split(/\n\s*\n/)
      .map((p) => p.trim())
      .find((p) => p && !p.startsWith('#') && !p.startsWith('---')) ?? '';
  const plain = para
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .replace(/\p{Extended_Pictographic}/gu, '')
    .replace(/\s+/g, ' ')
    .trim();
  const snippet = plain.length > 210 ? plain.slice(0, 210).replace(/\s+\S*$/, '') + '…' : plain;
  const date = n.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  return { id: n.id, no: allNotes.length - i, title: n.data.excerpt, date, snippet };
});

/** World placement: desktop x/y, rotation, optional mobile x/y. */
const at = (x: number, y: number, r = 0, m?: [number, number], mr?: number) =>
  `--x:${x}px;--y:${y}px;--r:${r}deg;` + (m ? `--mx:${m[0]}px;--my:${m[1]}px;` : '') + (mr != null ? `--mr:${mr}deg;` : '');

/** picsum: ask for a smaller rendition with the same aspect. */
const sized = (src: string, w: number) =>
  src.replace(/\/(\d+)\/(\d+)$/, (_, a, b) => `/${w}/${Math.round((w * +b) / +a)}`);

const [hero, ...rest] = photos;
const printSpots: [number, number, number][] = [
  [1790, 110, -2.5],
  [2150, 90, 2],
  [2620, 120, 3],
  [1470, 540, 1.5],
  [1900, 570, -2],
  [2330, 480, 2],
  [2600, 590, -1.5],
];
const cardSpots: [number, number, number][] = [
  [3420, 1095, 1.5],
  [3845, 1110, -1.5],
  [3015, 1385, -1],
  [3435, 1395, 2.5],
  [3850, 1405, -0.5],
  [3225, 1680, 1.5],
  [3650, 1690, -2],
];
const noteSpots: [number, number, number][] = [
  [1890, 2060, -1.5],
  [2255, 2045, 1],
  [2620, 2070, -0.5],
  [1900, 2390, 1.5],
  [2265, 2400, -1],
  [2630, 2380, 2],
];
const yearsOf = (y: string) => y.split('—').map((s) => s.trim());
const today = new Date();
const month = today.toLocaleDateString('en-AU', { month: 'long', year: 'numeric' });

const tabs = [
  { label: 'About', href: '#to-about', icon: 'person' as const },
  { label: 'Work', href: '#to-work', icon: 'briefcase' as const },
  { label: 'Projects', href: '#to-projects', icon: 'code' as const },
  { label: 'Photos', href: '#to-photos', icon: 'camera' as const },
  { label: 'Notes', href: '#to-notes', icon: 'note' as const },
];
const contents = [
  { n: 'I', label: 'Curriculum vitae', where: 'to the left', go: 'work' },
  { n: 'II', label: 'Side projects, on index cards', where: 'to the right', go: 'projects' },
  { n: 'III', label: 'Photographs', where: 'above', go: 'photos' },
  { n: 'IV', label: 'Notes to self', where: 'below', go: 'notes' },
];
const textures = [
  `--wood:${svgUrl(woodSvg)}`,
  `--felt:${svgUrl(feltSvg)}`,
  `--paper-grain:${svgUrl(paperSvg)}`,
  `--cloth:${svgUrl(clothSvg)}`,
].join(';');
---
<Base title="Desk — Joshua Germon" description="Joshua Germon, staff software engineer in Sydney — a desk you can rummage through." theme="light" class="dk">
  <div class="dk-viewport" aria-label="Josh's desk. Drag to look around; click an object to look closer.">
    <div class="dk-desk" style={textures}>
      <div class="dk-veneer" aria-hidden="true"></div>

      <!-- Felt desk mat under the cover composition -->
      <div class="dk-mat" aria-hidden="true" style={at(1545, 1040, 0, [1930, 1010])}></div>

      <!-- =================== COVER =================== -->
      <article class="dk-obj letter" data-e="2" style={at(1600, 1090, -1.2, [1975, 1060], -0.6)}>
        <header class="lt-head">
          <span>Sydney, Australia</span>
          <span>germon.me</span>
        </header>
        <h1 class="lt-name">Joshua<br />Germon</h1>
        <p class="lt-role">Staff Software Engineer <span>·</span> Photographer</p>
        <p class="lt-tag">{profile.tagline}</p>
        <p class="lt-body">{profile.intro}</p>
        <nav class="lt-contents" aria-label="On this desk">
          <h2>On this desk</h2>
          <ol>
            {contents.map((c) => (
              <li><button type="button" data-go={c.go}><span class="n">{c.n}</span><span class="l">{c.label}</span><span class="w">{c.where}</span></button></li>
            ))}
          </ol>
        </nav>
      </article>

      <liquid-glass
        class="dk-obj weight"
        data-e="34"
        radius="pill"
        bezel="96"
        profile="circle"
        refraction="80"
        dispersion="0"
        blur="0"
        aria-label="A glass paperweight — pick it up"
        style={at(1850, 1140, 0, [2225, 1290])}
      >
        <i class="pw-shadow" aria-hidden="true"></i>
        <i class="pw-edge" aria-hidden="true"></i>
        <i class="pw-spec" aria-hidden="true"></i>
      </liquid-glass>

      <section class="dk-obj bcard" data-e="3" aria-label="Business card" style={at(2250, 1100, 4, [2020, 1850], 3)}>
        <div class="bc-face">
          <p class="bc-name">Joshua Germon</p>
          <p class="bc-title">Staff Software Engineer</p>
          <ul class="bc-links">
            <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
            {profile.socials.slice(0, 2).map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.href.replace('https://', '')}</a></li>)}
          </ul>
          <span class="bc-city">Sydney</span>
          <span class="bc-mark" aria-hidden="true">JG</span>
        </div>
      </section>

      <aside class="dk-obj nowcard" data-e="2" style={at(2610, 1215, 3, [2470, 1080], 3)}>
        <p class="nc-k">Currently</p>
        <p class="nc-date">{month}</p>
        <dl>
          <dt>Building</dt><dd>{profile.now.building}</dd>
          <dt>Learning</dt><dd>{profile.now.learning}</dd>
          <dt>Shooting</dt><dd>{profile.now.shooting}</dd>
        </dl>
      </aside>

      <figure class="dk-obj print land hero" data-e="1.6" style={at(2150, 1475, -2.5, [2470, 1460], -2)}>
        <div class="pr-face">
          <img src={sized(hero.src, 900)} alt={hero.caption} width="900" height="600" loading="eager" draggable="false" crossorigin="anonymous" />
          <figcaption><span>{hero.caption}</span><span class="no">No. 01</span></figcaption>
        </div>
      </figure>

      <div class="dk-obj shape pencil" data-e="6" aria-hidden="true" style={at(2330, 1880, -24, [2085, 1800], 84)}>
        <i class="pc-tip"></i><i class="pc-body"><b>GERMON · HB</b></i><i class="pc-ferrule"></i><i class="pc-eraser"></i>
      </div>

      <!-- =================== WORK =================== -->
      <div class="dk-obj ruler" data-e="3" aria-hidden="true" style={at(560, 1060, 0.6)}>
        {Array.from({ length: 21 }, (_, i) => <span style={`--i:${i}`}>{i}</span>)}
      </div>
      <article class="dk-obj cv" data-e="2" aria-label="Curriculum vitae" style={at(760, 990, -0.8)}>
        <span class="clip" aria-hidden="true"><i class="clip-lever"></i></span>
        <header class="cv-top">
          <span>Curriculum Vitae</span>
          <span>{profile.location}<br /><a href={`mailto:${profile.email}`}>{profile.email}</a></span>
          <span>github.com/joshgermon<br />linkedin.com/in/joshgermon</span>
        </header>
        <h2 class="cv-name">Joshua<br />Germon</h2>
        <p class="cv-lede"><b>{profile.title}.</b> Nine years building platforms, payments and the tools engineers reach for without thinking. Based in Sydney.</p>
        <section class="cv-sec">
          <h3>Experience</h3>
          <ol class="cv-roles">
            {career.map((r) => {
              const [from, to] = yearsOf(r.years);
              return (
                <li>
                  <p class="cv-yrs"><span>{from}</span><span>{to}</span></p>
                  <div>
                    <h4>{r.title}</h4>
                    <p class="cv-co">{r.company}</p>
                    <p class="cv-sum">{r.summary}</p>
                    <ul>{r.highlights.map((h) => <li>{h}</li>)}</ul>
                    <p class="cv-stack">{r.stack.join(' / ')}</p>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
        <section class="cv-sec cv-nums">
          <h3>In numbers</h3>
          <dl>
            {stats.map((s) => (
              <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
            ))}
          </dl>
        </section>
        <footer class="cv-foot"><span>Joshua Germon</span><span>CV — {today.getFullYear()}</span><span>1 / 1</span></footer>
      </article>

      <!-- =================== PROJECTS =================== -->
      <div class="dk-obj shape divider" data-e="1.6" style={at(3000, 1090, -2)}>
        <span class="dv-tab">Projects</span>
        <p class="dv-h">Side projects</p>
        <p class="dv-p">Tools I wanted to exist, written in whatever language I was curious about that month. Seven cards, all on GitHub.</p>
        <p class="dv-count">{projects.length} cards · 2019 — now</p>
      </div>
      {projects.slice(0, cardSpots.length).map((p, i) => (
        <article class="dk-obj icard" data-e="1.6" style={at(...cardSpots[i])}>
          <header>
            <h3>{p.name}</h3>
            <span class="ic-lang">{p.lang}</span>
          </header>
          <p class="ic-blurb">{p.blurb}</p>
          <footer>
            <span class="ic-no">{String(i + 1).padStart(2, '0')}</span>
            <a href={p.href} target="_blank" rel="noopener">{p.href.replace('https://', '')} ↗</a>
          </footer>
        </article>
      ))}

      <!-- =================== PHOTOS =================== -->
      <div class="dk-obj tag" data-e="1.4" style={at(1480, 210, -3)}>
        <p class="tg-k">Prints</p>
        <p class="tg-h">Weekend work</p>
        <p class="tg-p">Mostly Sydney and the Blue Mountains, mostly at the edges of the day.</p>
        <p class="tg-m">{profile.now.shooting}</p>
      </div>
      {rest.slice(0, printSpots.length).map((p, i) => {
        const portrait = p.h > p.w;
        return (
          <figure class:list={['dk-obj', 'print', portrait ? 'port' : 'land']} data-e="1.6" style={at(...printSpots[i])}>
            <div class="pr-face">
              <img src={sized(p.src, portrait ? 640 : 820)} alt={p.caption} width={portrait ? 640 : 820} height={portrait ? 800 : 547} loading="lazy" decoding="async" draggable="false" />
              <figcaption><span>{p.caption}</span><span class="no">No. {String(i + 2).padStart(2, '0')}</span></figcaption>
            </div>
          </figure>
        );
      })}

      <!-- =================== NOTES =================== -->
      <div class="dk-obj notebook" data-e="10" aria-label="Notebook" style={at(1480, 2050, -3)}>
        <div class="nb-cover">
          <span class="nb-band" aria-hidden="true"></span>
          <span class="nb-ribbon" aria-hidden="true"></span>
          <div class="nb-label">
            <p>Notes</p>
            <small>Vol. 1 — {allNotes.length} entries<br />Aug — Sep 2022</small>
          </div>
        </div>
      </div>
      {notes.map((n, i) => (
        <article class="dk-obj npage" data-e="1.4" style={at(...noteSpots[i])}>
          <p class="np-meta"><span>No. {n.no}</span><span>{n.date}</span></p>
          <h3>{n.title}</h3>
          <p class="np-body">{n.snippet}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="dk-lamp" aria-hidden="true"></div>

  <p class="dk-hint" role="status"><span class="hint-d">Drag to look around</span><span class="sep hint-d"></span><span class="hint-d">Click anything to look closer</span><span class="hint-m">Drag around · tap to read</span></p>
  <a class="dk-home" href="/concepts">← Concepts</a>

  <TabBar items={tabs} spy={false} class="dk-tabs" />
</Base>

<script>
  import { initDesk } from '@/concepts/scrapbook-desk/desk';
  initDesk();
</script>
