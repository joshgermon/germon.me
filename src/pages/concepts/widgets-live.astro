---
/**
 * Concept — "Widgets: Live"
 * Fewer, bigger, alive. A StandBy-meets-desktop composition over the iPhone dune
 * wallpaper: a real mini-shell as the hero, a StandBy clock in clear liquid glass,
 * an rq Live Activity that keeps committing, a flickable photo deck, a vertical
 * Smart Stack for career, a scrubbable stats chart and a notes reader sheet.
 * A Dynamic Island reacts to all of it.
 */
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import TabBar from '@/components/TabBar.astro';
import Icon from '@/components/Icon.astro';
import { profile, career, stats, projects, photos } from '@/data/profile';
import '@/concepts/widgets-live/live.css';

const notesRaw = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = notesRaw.map((n) => {
  // The real headline is the first "## " line; the frontmatter title is just the date.
  const h2 = (n.body ?? '').match(/^##\s+(.+)$/m)?.[1] ?? n.data.excerpt;
  const headline = h2.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[*_`]/g, '').trim();
  const words = (n.body ?? '').split(/\s+/).filter(Boolean).length;
  return {
    id: n.id,
    title: n.data.excerpt,
    headline,
    date: n.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }),
    short: n.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', timeZone: 'UTC' }),
    mins: Math.max(1, Math.round(words / 220)),
  };
});
const noteBodies = await Promise.all(notesRaw.map(async (n) => (await render(n)).Content));

// TODO(josh): illustrative timeline behind the stats chart — swap for real milestones.
const timeline = [
  { y: 2017, v: 5, label: 'First job — agency years begin' },
  { y: 2018, v: 12, label: '20 client launches' },
  { y: 2019, v: 17, label: 'Built the shared component kit' },
  { y: 2020, v: 22, label: 'Senior · payments & auth' },
  { y: 2021, v: 38, label: 'Auth cutover · 1.4M accounts, zero downtime' },
  { y: 2022, v: 46, label: 'Cloud spend −38%' },
  { y: 2023, v: 59, label: 'Staff · platform group of five teams' },
  { y: 2024, v: 78, label: 'p99 latency −62%' },
  { y: 2025, v: 90, label: '120 engineers on the platform' },
  { y: 2026, v: 100, label: '41 open-source repos and counting' },
];

// TODO(josh): fake commit stream for the rq Live Activity.
const commits = [
  { h: '3f2a9c1', m: 'feat(auth): oauth2 client-credentials flow' },
  { h: 'b81e04d', m: 'fix(spec): resolve $ref across split files' },
  { h: '9c7d215', m: 'perf: stream large response bodies' },
  { h: 'e04b6aa', m: 'feat(tui): request history panel' },
  { h: '51ac3f0', m: 'chore: bump bubbletea to v1.2' },
  { h: 'a6d9e72', m: 'feat: env files with ${VAR} interpolation' },
  { h: '0db41c8', m: 'test(spec): petstore golden files' },
  { h: 'c3e8f19', m: 'feat(cli): rq send --watch' },
];

const data = {
  profile,
  career,
  stats,
  projects,
  photos: photos.map((p, i) => ({ ...p, file: `${String(i + 1).padStart(2, '0')}-${p.caption.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.jpg` })),
  notes,
  timeline,
  commits,
};

const tabs = [
  { label: 'Today', href: '#today', icon: 'grid' },
  { label: 'Work', href: '#work', icon: 'briefcase' },
  { label: 'Weekend', href: '#weekend', icon: 'camera' },
] as const;

const chips = ['help', 'whoami', 'ls', 'cd work', 'open photos', `cat notes/${notes[0]?.id ?? ''}`, 'neofetch', 'contact'];
const digits = Array.from({ length: 10 }, (_, i) => i);
---

<Base title="Josh Germon — Live" description="Staff engineer in Sydney. A home screen that's alive: a real shell, a StandBy clock, live activities.">
  <script type="application/json" id="wl-data" set:html={JSON.stringify(data)} />

  <div class="wp" aria-hidden="true">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="/wallpapers/dunes-dark-1200.jpg 1200w, /wallpapers/dunes-dark.jpg 2000w" sizes="100vw" />
      <img src="/wallpapers/dunes.jpg" srcset="/wallpapers/dunes-1200.jpg 1200w, /wallpapers/dunes.jpg 2000w" sizes="100vw" alt="" fetchpriority="high" decoding="async" />
    </picture>
  </div>

  <!-- Dynamic Island ------------------------------------------------------ -->
  <div class="island" data-state="boot">
    <liquid-glass class="isl-glass" radius="pill" bezel="12" refraction="16" dispersion="0.2" blur="6" static></liquid-glass>
    <button class="isl-hit" type="button" aria-label="Open contact card" aria-expanded="false"></button>

    <div class="isl-view" data-view="idle" aria-hidden="true">
      <div class="isl-row isl-split">
        <span class="rq-glyph rq-glyph--s">rq</span>
        <span class="isl-ring"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="8" /><circle cx="10" cy="10" r="8" pathLength="100" class="on" data-isl-ring /></svg><b data-isl-pct>72%</b></span>
      </div>
    </div>

    <div class="isl-view" data-view="la" aria-hidden="true">
      <div class="isl-row isl-la">
        <span class="rq-glyph">rq</span>
        <span class="isl-stack">
          <small>Now building · <span data-isl-ver>v0.9</span> → v1.0</small>
          <b data-isl-commit>feat(auth): oauth2 client-credentials flow</b>
          <span class="isl-bar"><i data-isl-bar></i></span>
        </span>
        <span class="isl-big" data-isl-pct2>72%</span>
      </div>
    </div>

    <div class="isl-view" data-view="cmd" aria-hidden="true">
      <div class="isl-row">
        <span class="isl-chev">❯</span>
        <code class="isl-cmd" data-isl-cmd>whoami</code>
        <span class="isl-status" data-isl-status></span>
      </div>
    </div>

    <div class="isl-view" data-view="photo" aria-hidden="true">
      <div class="isl-row">
        <img class="isl-thumb" data-isl-thumb alt="" src={photos[0].src.replace(/\/\d+\/\d+$/, '/80/80')} />
        <span class="isl-text" data-isl-caption>{photos[0].caption}</span>
        <span class="isl-count" data-isl-count>1/{photos.length}</span>
      </div>
    </div>

    <div class="isl-view" data-view="section" aria-hidden="true">
      <div class="isl-row">
        <span class="isl-dot"></span>
        <span class="isl-text" data-isl-section>Today</span>
        <span class="isl-count" data-isl-sub>3 widgets</span>
      </div>
    </div>

    <div class="isl-view" data-view="commit" aria-hidden="true">
      <div class="isl-row">
        <span class="rq-glyph rq-glyph--s">rq</span>
        <span class="isl-text">Pushed <code data-isl-hash>3f2a9c1</code></span>
        <span class="isl-up" data-isl-up>+1%</span>
      </div>
    </div>

    <div class="isl-view" data-view="contact" inert>
      <div class="isl-card">
        <div class="isl-card-top">
          <span class="isl-avatar">JG</span>
          <span class="isl-stack">
            <b>{profile.name}</b>
            <small>{profile.title} · {profile.location}</small>
          </span>
          <span class="isl-avail"><i></i>Open to chat</span>
        </div>
        <div class="isl-actions">
          <a class="isl-btn isl-btn--primary" href={`mailto:${profile.email}`}><Icon name="mail" size={17} />{profile.email}</a>
          {profile.socials.map((s) => (
            <a class="isl-btn" href={s.href} target="_blank" rel="noopener">{s.label === 'GitHub' ? <Icon name="github" size={16} /> : null}{s.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <header class="top">
    <div class="me">
      <b>{profile.name}</b>
      <span>{profile.title} · Sydney</span>
    </div>
    <liquid-glass class="hi-btn" radius="pill" bezel="14" refraction="20" dispersion="0.25" blur="2">
      <button type="button" data-contact><span class="hi-dot"></span>Say hi</button>
    </liquid-glass>
  </header>

  <main class="page">
    <!-- TODAY ----------------------------------------------------------- -->
    <section id="today" class="sec sec--today" data-title="Today" aria-label="Today">
      <h1 class="sr-only">{profile.name} — {profile.title}, {profile.location}</h1>

      <!-- The hero: a real little shell -->
      <div class="w term" data-w="terminal" style="--i:0">
        <div class="term-chrome">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="term-title"><b>josh@germon.me</b> <span data-cwd-title>~</span> — zsh</span>
          <span class="term-kbd" aria-hidden="true"><kbd>tab</kbd> complete · <kbd>↑</kbd> history</span>
        </div>
        <div class="term-scroll" data-term-scroll>
          <div class="term-log" role="log" aria-live="polite" aria-label="Terminal output" data-term-log></div>
        </div>
        <div class="term-dock">
          <div class="term-chips" role="toolbar" aria-label="Suggested commands">
            {chips.map((c) => <button type="button" class="chip" data-run={c}>{c}</button>)}
          </div>
          <label class="term-line" data-term-line>
            <span class="prompt" data-prompt><span class="pr-path">~</span><span class="pr-chev">❯</span></span>
            <span class="buf" aria-hidden="true"><span data-before></span><span class="cur" data-cur> </span><span data-after></span><span class="ghost" data-ghost></span></span>
            <input data-term-input type="text" aria-label="Type a command (try help)" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="go" />
          </label>
        </div>
      </div>

      <!-- rq Live Activity -->
      <article class="w la" data-w="live-activity" style="--i:1" aria-label="Live Activity — building rq">
        <div class="la-head">
          <span class="rq-glyph rq-glyph--l">rq</span>
          <div class="la-title">
            <b>Building rq</b>
            <small>OpenAPI-native API client · Go</small>
          </div>
          <span class="la-live"><i></i>Live</span>
        </div>
        <div class="la-mid">
          <div class="la-pct"><b data-la-pct>72.0</b><span>%</span></div>
          <div class="la-target">
            <small>to v1.0</small>
            <span data-la-eta>~3 weeks</span>
          </div>
        </div>
        <div class="la-track" aria-hidden="true">
          <i class="la-fill" data-la-fill></i>
          {[25, 50, 75].map((m) => <i class="la-tick" style={`left:${m}%`}></i>)}
        </div>
        <div class="la-steps" aria-hidden="true"><span>spec</span><span>editor</span><span>auth</span><span>plugins</span></div>
        <button class="la-ticker" type="button" aria-expanded="false" aria-controls="la-more" data-la-toggle>
          <span class="la-tick-icon"><Icon name="code" size={14} /></span>
          <span class="la-roll" data-la-roll>
            <span class="la-commit" data-la-commit><code>{commits[0].h}</code>{commits[0].m}</span>
          </span>
          <span class="la-ago" data-la-ago>just now</span>
        </button>
        <div class="la-more" id="la-more">
          <ol data-la-list>
            {commits.slice(1, 5).map((c, i) => <li><code>{c.h}</code><span>{c.m}</span><small>{(i + 1) * 3}h</small></li>)}
          </ol>
        </div>
      </article>

      <!-- StandBy clock — the glass hero -->
      <liquid-glass class="w clock" data-w="clock" style="--i:2" radius="44" bezel="30" refraction="52" dispersion="0.28" blur="1.2">
        <div class="ck-top">
          <span><Icon name="location" size={15} />Sydney</span>
          <span data-ck-date>&nbsp;</span>
        </div>
        <div class="ck-time" role="timer" aria-label="Time in Sydney" data-ck-time>
          <span class="dg" data-dg="0"><span class="strip">{digits.map((d) => <span>{d}</span>)}</span></span>
          <span class="dg" data-dg="1"><span class="strip">{digits.map((d) => <span>{d}</span>)}</span></span>
          <span class="colon">:</span>
          <span class="dg" data-dg="2"><span class="strip">{digits.map((d) => <span>{d}</span>)}</span></span>
          <span class="dg" data-dg="3"><span class="strip">{digits.map((d) => <span>{d}</span>)}</span></span>
          <span class="ampm" data-ck-ampm>am</span>
        </div>
        <div class="ck-sun" aria-hidden="true">
          <svg viewBox="0 0 300 40" preserveAspectRatio="none">
            <path d="M0 36 H300" class="hz" />
            <path d="M18 36 C 90 -6, 210 -6, 282 36" class="arc" pathLength="100" />
            <path d="M18 36 C 90 -6, 210 -6, 282 36" class="arc-on" pathLength="100" data-ck-arc />
          </svg>
          <i class="sun" data-ck-sun></i>
        </div>
        <div class="ck-foot">
          <span data-ck-rise>↑ 5:42am</span>
          <span data-ck-diff>&nbsp;</span>
          <span data-ck-set>↓ 7:41pm</span>
        </div>
      </liquid-glass>
    </section>

    <!-- WORK ------------------------------------------------------------ -->
    <section id="work" class="sec sec--work" data-title="Work" aria-labelledby="work-h">
      <h2 class="sec-h" id="work-h">Work <span>nine years, three chapters</span></h2>

      <div class="w stackw" data-w="career" style="--i:0" tabindex="0" role="region" aria-roledescription="Smart Stack" aria-label="Career — flick or use arrow keys">
        <div class="stack" data-stack>
          {career.map((r, i) => (
            <article class="sc" aria-label={`${r.title}, ${r.years}`}>
              <div class="sc-top">
                <span class="sc-kicker">{r.years}</span>
                <span class="sc-n">{String(i + 1).padStart(2, '0')}<em>/{String(career.length).padStart(2, '0')}</em></span>
              </div>
              <h3 class="sc-title">{r.title}</h3>
              <p class="sc-co">{r.company}</p>
              <p class="sc-sum">{r.summary}</p>
              <ul class="sc-hl">{r.highlights.slice(0, 3).map((h) => <li>{h}</li>)}</ul>
              <ul class="sc-tags">{r.stack.slice(0, 5).map((s) => <li>{s}</li>)}</ul>
            </article>
          ))}
        </div>
        <div class="stack-dots" aria-hidden="true">{career.map(() => <i></i>)}</div>
        <span class="stack-hint" aria-hidden="true">flick ↕</span>
      </div>

      <div class="w chart" data-w="stats" style="--i:1" tabindex="0" role="group" aria-label="Career chart — use left and right arrows to scrub years">
        <div class="ch-head">
          <div>
            <small class="ch-kicker">JOSH · impact index</small>
            <div class="ch-big"><b data-ch-year>2026</b><span class="ch-delta" data-ch-delta>+9 yrs</span></div>
            <p class="ch-label" data-ch-label>{timeline[timeline.length - 1].label}</p>
          </div>
          <span class="ch-range" aria-hidden="true">2017 — now</span>
        </div>
        <div class="ch-plot" data-ch-plot>
          <svg viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="wl-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ffb26b" stop-opacity="0.38" />
                <stop offset="1" stop-color="#ffb26b" stop-opacity="0" />
              </linearGradient>
            </defs>
            {[0, 1, 2, 3].map((g) => <line x1="0" x2="1000" y1={30 + g * 80} y2={30 + g * 80} class="grid" />)}
            <path class="area" data-ch-area d="" />
            <path class="line" data-ch-line d="" pathLength="1" />
          </svg>
          <div class="ch-dots" data-ch-dots></div>
          <i class="ch-scrub" data-ch-scrub><b></b></i>
        </div>
        <div class="ch-years" aria-hidden="true">{timeline.map((t) => <span>{String(t.y).slice(2)}</span>)}</div>
        <dl class="ch-stats">
          {stats.map((s) => (
            <div><dt>{s.label}</dt><dd data-count={s.value}>{s.value}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <!-- WEEKEND --------------------------------------------------------- -->
    <section id="weekend" class="sec sec--weekend" data-title="Weekend" aria-labelledby="wk-h">
      <h2 class="sec-h" id="wk-h">Weekend <span>photos &amp; notes</span></h2>

      <div class="w deckw" data-w="photos" style="--i:0" role="region" aria-roledescription="Photo deck" aria-label="Photos — flick cards, or use arrow keys">
        <div class="deck" data-deck tabindex="0">
          {photos.map((p, i) => (
            <figure class="card" data-card={i}>
              <img src={p.src} alt={p.caption} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" draggable="false" crossorigin="anonymous" />
              <figcaption><span>{p.caption}</span><small>{profile.now.shooting}</small></figcaption>
            </figure>
          ))}
        </div>
        <liquid-glass class="deck-ctl" radius="pill" bezel="16" refraction="22" dispersion="0.25" blur="2.5">
          <button type="button" data-deck-prev aria-label="Previous photo"><Icon name="chevronLeft" size={18} /></button>
          <span class="deck-count" aria-live="polite"><b data-deck-i>1</b> / {photos.length}</span>
          <button type="button" data-deck-next aria-label="Next photo"><Icon name="arrow" size={18} /></button>
        </liquid-glass>
      </div>

      <div class="w notes" data-w="notes" style="--i:1">
        <div class="nt-head">
          <h3><Icon name="note" size={16} />Notes</h3>
          <span>{notes.length}</span>
        </div>
        <button type="button" class="nt-feature" data-note={notes[0].id}>
          <small>{notes[0].date} · {notes[0].mins} min read</small>
          <b>{notes[0].headline}</b>
          <span>{notes[0].title}</span>
        </button>
        <ul class="nt-list">
          {notes.slice(1).map((n) => (
            <li>
              <button type="button" data-note={n.id}>
                <time>{n.short}</time>
                <span>{n.title}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <footer class="foot">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span>Wallpaper: dunes · Built with Astro</span>
    </footer>
  </main>

  <TabBar items={[...tabs]} />

  <!-- Notes reader sheet ------------------------------------------------- -->
  <div class="scrim" hidden data-scrim></div>
  <div class="sheet" hidden role="dialog" aria-modal="true" aria-labelledby="rd-title" data-sheet>
    <div class="rd-progress" aria-hidden="true"><i data-rd-progress></i></div>
    <div class="rd-grab" data-rd-grab aria-hidden="true"><i></i></div>
    <div class="rd-bar">
      <button type="button" class="rd-btn" data-rd-prev aria-label="Newer note"><Icon name="chevronLeft" size={17} /></button>
      <span class="rd-meta" data-rd-meta></span>
      <button type="button" class="rd-btn" data-rd-next aria-label="Older note"><Icon name="arrow" size={17} /></button>
      <button type="button" class="rd-btn rd-close" data-rd-close aria-label="Close reader"><Icon name="close" size={17} /></button>
    </div>
    <div class="rd-scroll" data-rd-scroll>
      <article class="rd" data-rd>
        <p class="rd-kicker" data-rd-kicker></p>
        <h2 class="rd-title" id="rd-title" data-rd-title></h2>
        <div class="rd-body" data-rd-body></div>
      </article>
    </div>
  </div>
  {notesRaw.map((n, i) => {
    const Body = noteBodies[i];
    return <template data-note-body={n.id}><Body /></template>;
  })}

  <script>
    import { boot } from '@/concepts/widgets-live/app';
    boot();
  </script>
</Base>
