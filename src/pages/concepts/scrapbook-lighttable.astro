---
/**
 * Scrapbook — "Light table".
 * A photographer's graphite work surface with a big backlit panel. Slides,
 * negatives and archive cards sit on it; everything can be picked up and
 * thrown; a metal-rimmed glass loupe magnifies whatever it passes over.
 */
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@/concepts/scrapbook-lighttable/lighttable.css';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import TabBar from '@/components/TabBar.astro';
import Mount from '@/concepts/scrapbook-lighttable/Mount.astro';
import NegStrip from '@/concepts/scrapbook-lighttable/NegStrip.astro';
import { profile, career, stats, projects, photos } from '@/data/profile';

const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6)
  .map((n) => {
    const para =
      (n.body ?? '')
        .split(/\n\s*\n/)
        .map((p) => p.trim())
        .find((p) => p && !p.startsWith('#') && !p.startsWith('---')) ?? '';
    const plain = para
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/[*_`>#]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
    const snippet = plain.length > 200 ? plain.slice(0, 200).replace(/\s+\S*$/, '') + '…' : plain;
    const d = n.data.date;
    const date = `${String(d.getUTCDate()).padStart(2, '0')}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCFullYear()).slice(2)}`;
    return { id: n.id, title: n.data.excerpt, date, snippet };
  });
const [frontNote, ...trayNotes] = notes;

/** Desktop world placement: x/y in px, resting rotation in deg. */
const at = (x: number, y: number, r = 0) => `--x:${x}px;--y:${y}px;--r:${r}deg;`;

const [hero, ...rest] = photos;
const slides = rest.slice(0, 6);
const square = rest[6] ?? rest[0];
const negFrames = [rest[3], rest[0], rest[4], hero, rest[2], rest[5]].map((p) => ({ src: p.src, alt: p.caption }));

const slideSpots: [number, number, number][] = [
  [2040, 372, -1.2],
  [2318, 360, 0.8],
  [2034, 650, 0.6],
  [2322, 646, -0.9],
  [2046, 930, -0.4],
  [2316, 934, 1.1],
];
const projSpots: [number, number, number][] = [
  [700, 1196, -0.8],
  [1022, 1188, 0.6],
  [1346, 1200, -0.4],
  [1668, 1192, 1],
  [704, 1516, 0.7],
  [1026, 1520, -0.9],
  [1348, 1512, 0.3],
];
const workSpots: [number, number, number][] = [
  [720, 1978, -0.6],
  [1246, 1966, 0.5],
  [1772, 1980, -0.3],
];
const statKeys = ['YRS', 'ENG', 'P99', 'OSS'];
const tabs = [
  { label: 'About', href: '#to-about', icon: 'person' as const },
  { label: 'Work', href: '#to-work', icon: 'briefcase' as const },
  { label: 'Projects', href: '#to-projects', icon: 'code' as const },
  { label: 'Photos', href: '#to-photos', icon: 'camera' as const },
  { label: 'Notes', href: '#to-notes', icon: 'note' as const },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Light table — Joshua Germon" theme="dark" class="lt">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <!-- Wax drag: break up the stroke edge and let a little base show through. -->
      <filter id="lt-wax" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.55 1.6" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" xChannelSelector="R" yChannelSelector="G" result="d" />
        <feComponentTransfer in="n" result="grain"><feFuncA type="discrete" tableValues="1 1 1 1 0.55 1 1 1 1 0.7" /></feComponentTransfer>
        <feComposite in="d" in2="grain" operator="in" />
      </filter>
    </defs>
  </svg>

  <div class="lt-viewport" aria-label="Josh's light table — drag to explore">
    <div class="lt-desk">
      <!-- ================= THE LIGHT PANEL ================= -->
      <div class="lt-panel" aria-hidden="false">
        <div class="lt-diffuser" aria-hidden="true"></div>
        <div class="lt-bezel-plate">
          <span class="plate">
            <b>JG&nbsp;LT-5000</b>
            <span>5000&nbsp;K · Ra&nbsp;98 · 230&nbsp;V</span>
          </span>
          <button class="lt-switch" type="button" aria-pressed="true" aria-label="Light panel power">
            <span class="rocker"><i>I</i><i>O</i></span>
          </button>
          <span class="lt-led" aria-hidden="true"></span>
        </div>
      </div>

      <!-- Section marks typeset on the graphite -->
      <p class="lt-mark" style={at(640, 214)}><span>01</span> Light table · contact &amp; selects</p>
      <p class="lt-mark" style={at(720, 1900)}><span>02</span> Work · archive records</p>
      <p class="lt-mark" style={at(2780, 254)}><span>05</span> Notes · card file</p>

      <!-- ================= ABOUT / COVER ================= -->
      <article class="lt-item card title-card on-light" data-r="-0.6" data-m="1" data-region="about" style={at(690, 372, -0.6)}>
        <header class="tc-head mono">
          <span><em>Roll 01</em> · Contact</span>
          <span>SYD · 33.87°S 151.21°E</span>
        </header>
        <h1 class="tc-name">Joshua Germon</h1>
        <p class="tc-role">{profile.title}</p>
        <p class="tc-tag">{profile.tagline}</p>
        <dl class="tc-fields">
          <dt class="mono">Subject</dt><dd>Platforms, systems &amp; photographs</dd>
          <dt class="mono">Location</dt><dd>{profile.location}</dd>
          <dt class="mono">Camera</dt><dd>{profile.now.shooting}</dd>
        </dl>
        <footer class="tc-links">
          <a href={`mailto:${profile.email}`} class="tc-mail">{profile.email}<span aria-hidden="true">↗</span></a>
          {profile.socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
        </footer>
      </article>

      <figure class="lt-item tranny tranny-67 on-light" data-r="0.8" data-m="2" style={at(1300, 356, 0.8)}>
        <div class="sleeve">
          <div class="rebate">
            <span class="rb-print rb-top mono" aria-hidden="true">KODAK E100 &nbsp;▸ 7 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 120 &nbsp; ▸ 8</span>
            <img class="film" src={hero.src} alt={hero.caption} loading="eager" draggable="false" crossorigin="anonymous" />
            <span class="rb-print rb-bottom mono" aria-hidden="true">E100 &nbsp;&nbsp; 7 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; KODAK</span>
          </div>
          <figcaption class="sticker">
            <span class="mono">№ 07 · 6×7</span>
            <span>{hero.caption}</span>
          </figcaption>
        </div>
      </figure>

      <div class="lt-item strip-wrap on-light" data-r="-0.4" data-m="3" style={at(700, 930, -0.4)}>
        <NegStrip frames={negFrames} start={14} fav={3} />
      </div>

      <div class="lt-item marker" data-r="-7" data-m="4" style={at(1470, 1118, -4)} aria-label="Red china marker">
        <span class="mk-tip" aria-hidden="true"></span>
        <span class="mk-body" aria-hidden="true"><span class="mono">CHINA MARKER · RED · 173T</span></span>
        <span class="mk-string" aria-hidden="true"></span>
      </div>

      <!-- ================= PHOTOS ================= -->
      {slides.map((p, i) => (
        <div class="lt-item slide on-light" data-r={slideSpots[i][2]} data-m={`${10 + Math.floor(i / 2)}`} data-region={i === 0 ? 'photos' : undefined} style={at(...slideSpots[i])}>
          <Mount top={`JG · ${pad(i + 2)}`} topRight="2025" photo={{ src: p.src, alt: p.caption }} caption={p.caption} />
        </div>
      ))}
      <article class="lt-item card label-card on-light" data-r="0.4" data-m="13" style={at(2050, 1224, 0.4)}>
        <header class="mono"><span>Slides · weekend work</span><span>06 / 36</span></header>
        <p>Six selects from the last few rolls. Mostly the coast, the mountains and whatever the light is doing at 5:40pm.</p>
        <p class="mono small">{profile.now.shooting}</p>
      </article>
      <figure class="lt-item tranny tranny-66 on-light" data-r="-1.2" data-m="14" style={at(2074, 1420, -1.2)}>
        <div class="sleeve">
          <div class="rebate">
            <img class="film" src={square.src} alt={square.caption} loading="lazy" draggable="false" crossorigin="anonymous" />
            <span class="rb-print rb-bottom mono" aria-hidden="true">PROVIA 100F &nbsp;&nbsp; 11</span>
          </div>
          <figcaption class="sticker"><span class="mono">№ 11 · 6×6</span><span>{square.caption}</span></figcaption>
        </div>
      </figure>

      <!-- ================= PROJECTS ================= -->
      {projects.slice(0, projSpots.length).map((p, i) => (
        <a class="lt-item slide project on-light" href={p.href} target="_blank" rel="noopener" draggable="false" data-r={projSpots[i][2]} data-m={`${20 + i}`} data-region={i === 0 ? 'projects' : undefined} style={at(...projSpots[i])}>
          <Mount top={`PRJ · ${pad(i + 1)}`} topRight="↗" title={p.name} sub={p.lang} caption={p.blurb} />
        </a>
      ))}
      <article class="lt-item card box-label on-light" data-r="-0.5" data-m="27" style={at(1676, 1520, -0.5)}>
        <span class="mono bl-kicker">Box 03</span>
        <h2>Side projects</h2>
        <p>Title slides for the things I build after hours: daemons, servers, interpreters and the odd tool that scratches one itch.</p>
        <a class="mono" href="https://github.com/joshgermon" target="_blank" rel="noopener">github.com/joshgermon ↗</a>
      </article>

      <!-- ================= WORK ================= -->
      {career.slice(0, workSpots.length).map((r, i) => (
        <article class="lt-item card record" data-r={workSpots[i][2]} data-m={`${40 + i}`} data-region={i === 0 ? 'work' : undefined} style={at(...workSpots[i])}>
          <header class="rc-head mono">
            <span>Record {pad(i + 1)} / {pad(career.length)}</span>
            <span>{r.years.replace('—', '–')}</span>
          </header>
          <h3>{r.title}</h3>
          <p class="rc-co mono">{r.company}</p>
          <p class="rc-sum">{r.summary}</p>
          <ol class="rc-list">
            {r.highlights.map((h, j) => <li><span class="mono">{pad(j + 1)}</span><span>{h}</span></li>)}
          </ol>
          <p class="rc-stack mono"><span>Stack</span>{r.stack.join(' · ')}</p>
                  </article>
      ))}

      <!-- ================= READOUT (stats) + NOW ================= -->
      <div class="lt-item meter" data-r="-2" data-m="50" style={at(284, 380, -2)}>
        <div class="mt-dome" aria-hidden="true"><span></span></div>
        <p class="mt-brand mono">LM-17 · <b>Exposure</b> meter</p>
        <div class="mt-lcd" aria-live="polite">
          {stats.map((s, i) => (
            <div class="mt-row">
              <span class="mt-key mono">{statKeys[i]}</span>
              <span class="mt-label">{s.label}</span>
              <span class="mt-val mono"><i aria-hidden="true">{s.value.replace(/\d/g, '8')}</i><b>{s.value}</b></span>
            </div>
          ))}
        </div>
        <div class="mt-buttons">
          <button type="button" class="mt-btn mono" data-meas>Meas</button>
          <span class="mt-btn mono" aria-hidden="true">ISO</span>
          <span class="mt-btn mono" aria-hidden="true">Mode</span>
        </div>
      </div>
      <article class="lt-item card now-card" data-r="1.4" data-m="51" style={at(272, 1010, 1.2)}>
        <header class="mono"><span>Now</span><span>Nov 2026</span></header>
        <dl>
          <dt class="mono">Building</dt><dd>{profile.now.building}</dd>
          <dt class="mono">Learning</dt><dd>{profile.now.learning}</dd>
          <dt class="mono">Shooting</dt><dd>{profile.now.shooting}</dd>
        </dl>
      </article>

      <!-- ================= NOTES ================= -->
      <div class="lt-item tray" data-r="0.6" data-m="60" data-region="notes" style={at(2800, 320, 0.6)}>
        <div class="tray-well">
          <span class="tray-divider mono">Notes · 2022</span>
          {trayNotes.map((n) => (
            <div class="tray-card">
              <span class="mono">{n.date}</span>
              <span class="tc-t">{n.title}</span>
            </div>
          ))}
          <article class="tray-card front">
            <header class="mono"><span>{frontNote.date}</span><span>№ {notes.length}</span></header>
            <h3>{frontNote.title}</h3>
            <p>{frontNote.snippet}</p>
          </article>
        </div>
        <span class="tray-pull" aria-hidden="true"></span>
      </div>
      {trayNotes[0] && (
        <article class="lt-item card index-card" data-r="3.2" data-m="61" style={at(3150, 800, 3.2)}>
          <header class="mono"><span>{trayNotes[0].date}</span><span>Pulled</span></header>
          <h3>{trayNotes[0].title}</h3>
          <p>{trayNotes[0].snippet}</p>
        </article>
      )}
    </div>
  </div>

  <a class="lt-home mono" href="/concepts">← Concepts</a>
  <p class="lt-hint mono" role="status">Drag the table<span class="wide"> · pick things up</span> · move the loupe</p>

  <div class="lt-loupe" role="img" aria-label="Glass loupe — drag it over the slides">
    <div class="lp-shadow" aria-hidden="true"></div>
    <div class="lp-ring" aria-hidden="true">
      <svg class="lp-engrave" viewBox="0 0 200 200">
        <defs><path id="lp-arc" d="M100 100m-86 0a86 86 0 1 1 172 0a86 86 0 1 1 -172 0" /></defs>
        <text><textPath href="#lp-arc" startOffset="2%">JG OPTICAL · 4× APLANAT · 5000 K · MADE IN SYDNEY · JG OPTICAL · 4× APLANAT ·</textPath></text>
      </svg>
    </div>
    <div class="lp-lens">
      <div class="lp-view" aria-hidden="true"></div>
      <liquid-glass class="lp-glass" radius="pill" bezel="46" profile="circle" refraction="54" dispersion="0.05" blur="0" static></liquid-glass>
      <span class="lp-vignette" aria-hidden="true"></span>
      <span class="lp-spec" aria-hidden="true"></span>
    </div>
  </div>

  <TabBar items={tabs} spy={false} class="lt-tabs" />
</Base>

<script>
  import { initTable } from '@/concepts/scrapbook-lighttable/table';
  initTable();
</script>
