---
/**
 * Bento · Combo — Editorial's voice on Command's bones.
 * One large sentence introduces Josh (serif-italic outline pills, focus-pull
 * reveal, hover previews) over Editorial's switchable dark backdrop. Underneath,
 * Command's neat Raycast-extension bento. There is one navigation idea: the
 * slim "What would you like to do? ⌘K" pill in the top bar, which grows into
 * the command palette; the five suggested actions sit under the sentence, and
 * the pills themselves are commands too. On a phone, every overlay is the same
 * draggable bottom sheet.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Ico, { type IcoName } from '@/concepts/bento-combo/Ico.astro';
import Pass from '@/concepts/bento-combo/Pass.astro';
import { brandOf } from '@/concepts/widgets-system/brands';
import { langColor } from '@/concepts/widgets-system/data';
import { getContributions } from '@/concepts/widgets-system/github';
import { profile, career } from '@/data/profile';
import { getRepos } from '@/data/github';
import { fortnight, coffeeGrid, coffeeHref } from '@/concepts/bento-combo/coffee';
import '@/concepts/bento-combo/combo.css';

const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const noteContent = await Promise.all(notes.map(async (n) => (await render(n)).Content));
const plain = (md = '') =>
  md
    .replace(/^#.*$/gm, '')
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>]/g, '')
    .replace(/^\s*-\s+/gm, '')
    .replace(/\s+/g, ' ')
    .trim();
const fmt = (d: Date, o: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric' }) => d.toLocaleDateString('en-AU', o);
const words = (md = '') => plain(md).split(' ').filter(Boolean).length;

// Real GitHub data (build time) ------------------------------------------------
const gh = await getContributions();
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthLabels = gh.weeks.map((w, i) => {
  const d = w.find(Boolean);
  if (!d) return '';
  const m = new Date(`${d.date}T00:00:00`).getMonth();
  const prev = gh.weeks[i - 1]?.find(Boolean);
  return !prev || new Date(`${prev.date}T00:00:00`).getMonth() !== m ? monthNames[m] : '';
});
const series = gh.weekly.reduce<number[]>((acc, v) => [...acc, (acc[acc.length - 1] ?? 0) + v], []);
const hiV = Math.max(4, ...series) * 1.08;
const sx = (i: number) => (i / Math.max(1, series.length - 1)) * 100;
const sy = (v: number) => 40 - (v / hiV) * 38;
const spark = series.map((v, i) => `${i ? 'L' : 'M'}${sx(i).toFixed(2)},${sy(v).toFixed(2)}`).join(' ');
const busiest = Math.max(...gh.weekly);
const n = (v: number) => v.toLocaleString('en-AU');

const email = profile.email;
const [gitHub, linkedIn, x] = profile.socials;
const kodo = career[0];
const cam = profile.camera;
const latest = notes[0];
const cf = fortnight();

// Live repos (build time, static fallback) --------------------------------------
const repos = await getRepos(7);
/** "3 weeks ago" → "3w": recency, said quietly. */
const ago = (iso: string) => {
  if (!iso) return '';
  const d = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 86_400_000));
  return d < 1 ? 'today' : d < 14 ? `${d}d` : d < 60 ? `${Math.round(d / 7)}w` : d < 365 ? `${Math.round(d / 30)}mo` : `${Math.round(d / 365)}y`;
};
const langs = [...new Set(repos.map((r) => r.lang))].slice(0, 3);

/* -------------------------------------------------------------------------- */
/* The sentence (Editorial). Strings split into words for the focus-pull;      */
/* objects are pills — each one is also a command.                             */
/* -------------------------------------------------------------------------- */
type Pill = { pill: string; key: string; to: string; act: string; cta: string; title: string; dot?: string; avatar?: boolean; pass?: number };
const sentence: (string | Pill)[] = [
  'I’m',
  { pill: 'Josh', key: 'josh', to: 'contact', act: 'jump:contact', cta: 'Show contact', title: 'Josh Germon', avatar: true },
  'Germon, founding engineer at',
  { pill: 'Kodo', key: 'kodo', to: 'engineering', act: 'view:career@role-0', cta: 'Open Kodo pass', title: 'Kodo', dot: brandOf('Kodo').bg, pass: 0 },
  'in',
  { pill: 'Sydney', key: 'sydney', to: 'coffee', act: 'coffee:pick', cta: 'Pick a morning', title: 'Grab a coffee' },
  '. I write',
  { pill: 'notes', key: 'notes', to: 'notes', act: `view:notes@note-${latest.id}`, cta: 'Read the latest note', title: 'Notes' },
  ', take',
  { pill: 'photos', key: 'photos', to: 'golden', act: 'jump:golden', cta: 'Show golden hour', title: 'Golden hour' },
  'and build small',
  { pill: 'tools', key: 'tools', to: 'projects', act: 'view:projects', cta: 'Browse projects', title: 'Projects' },
  'in the',
  { pill: 'terminal', key: 'terminal', to: 'terminal', act: 'term:help', cta: 'Open the terminal', title: 'Terminal' },
  '. Previously at',
  { pill: 'nib', key: 'nib', to: 'engineering', act: 'view:career@role-1', cta: 'Open nib pass', title: 'nib', dot: '#82e578', pass: 1 },
  'and',
  { pill: 'Jala', key: 'jala', to: 'engineering', act: 'view:career@role-2', cta: 'Open Jala pass', title: 'Jala Design', dot: '#ffffff', pass: 2 },
  '.',
  { pill: 'Lately', key: 'now', to: 'now', act: 'jump:now', cta: 'Show now', title: 'Now' },
  ', AI tooling and the platforms under it.',
];
type Tok = { t: 'w'; s: string; i: number } | { t: 'p'; p: Pill; tail: string; i: number };
const tokens: Tok[] = [];
let wi = 0;
for (const seg of sentence) {
  if (typeof seg === 'string') {
    const m = seg.match(/^([.,:;]+)\s*(.*)$/);
    const last = tokens[tokens.length - 1];
    let rest = seg;
    if (m && last?.t === 'p') {
      last.tail = m[1];
      rest = m[2];
    }
    for (const s of rest.split(/\s+/).filter(Boolean)) tokens.push({ t: 'w', s, i: wi++ });
  } else tokens.push({ t: 'p', p: seg, tail: '', i: wi++ });
}

/* -------------------------------------------------------------------------- */
/* Palette (Command): every root command → a list row + a detail pane.         */
/* -------------------------------------------------------------------------- */
type Cmd = {
  id: string;
  title: string;
  sub?: string;
  icon: IcoName;
  kw?: string;
  act: string;
  label: string;
  alt?: string;
  altLabel?: string;
  acc?: string;
  kind?: string;
  keys?: string[];
  desc?: string;
  meta?: [string, string][];
};

const coffeeMeta: [string, string][] = [['When', 'Weekday mornings'], ['Where', 'Sydney CBD'], ['Next free', cf.first.short]];
const suggested: (Cmd & { chip: string })[] = [
  { id: 's-read', chip: 'Read latest note', title: 'Read Latest Note', sub: latest.data.excerpt, icon: 'note', act: `view:notes@note-${latest.id}!`, label: 'Read Note', alt: 'view:notes', altLabel: 'All Notes', desc: plain(latest.body).slice(0, 180) + '…', meta: [['Title', latest.data.excerpt], ['Published', fmt(latest.data.date)], ['Length', `${words(latest.body)} words`]] },
  { id: 's-email', chip: 'Email Josh', title: 'Email Josh', sub: email, icon: 'mail', act: 'mail', label: 'Open Mail', alt: 'copy:email', altLabel: 'Copy Email', desc: 'Inbox is open: platforms, AI tooling, developer experience, or a camera recommendation. Usually replies within a day.', meta: [['To', email], ['Based in', profile.location]] },
  { id: 's-work', chip: 'View engineering work', title: 'View Engineering Work', sub: `${career.length} roles`, icon: 'wallet', act: 'view:career', label: 'Open Passes', alt: 'view:career@role-0', altLabel: 'Open Kodo Pass', desc: 'Four roles, startup to enterprise — one pass each, in the company’s own colours.', meta: career.map((r) => [r.company, r.years.replace(' — ', '–')]) },
  { id: 's-github', chip: 'Open GitHub', title: 'Open GitHub', sub: gitHub.handle, icon: 'github', act: `href:${gitHub.href}`, label: 'Open in Browser', alt: 'view:projects', altLabel: 'Browse Projects', desc: 'Repos, stars and the occasional half-finished idea.', meta: [['Profile', gitHub.href.replace('https://', '')], ['Last push', repos[0]?.updated || '—']] },
  { id: 's-coffee', chip: 'Book a coffee', title: 'Book a Coffee', sub: 'Pick a weekday morning', icon: 'coffee', act: 'coffee:pick', label: 'Pick a Morning', alt: 'coffee:mail', altLabel: 'Ask for the Next Free Morning', desc: 'Two weeks of weekday mornings in Sydney. Pick one and it drafts the email — or a call from anywhere.', meta: coffeeMeta },
];
const suggestions = suggested.map((c, k) => ({ ...c, keys: ['⌥', String(k + 1)] }));

const navigate: Cmd[] = [
  { id: 'c-notes', title: 'Browse Notes', icon: 'folder', kw: 'read writing blog posts', act: 'view:notes', label: 'Open Notes', alt: 'jump:notes', altLabel: 'Show Widget', acc: `${notes.length}`, kind: 'View', desc: 'Short notes, mostly about software and the things around it.', meta: [['Notes', String(notes.length)], ['Latest', latest.data.excerpt], ['Updated', fmt(latest.data.date)]] },
  { id: 'c-career', title: 'Browse Engineering', icon: 'wallet', kw: 'career work history jobs roles passes cv resume kodo nib jala freelance', act: 'view:career', label: 'Open Passes', alt: 'jump:engineering', altLabel: 'Show Widget', acc: `${career.length}`, kind: 'View', desc: 'Every role as a pass.', meta: career.map((r) => [r.company, r.title]) },
  { id: 'c-kodo', title: 'View Kodo Pass', sub: 'Founding Engineer', icon: 'wallet', kw: 'career current job work engineering', act: 'view:career@role-0', label: 'Open Pass', kind: 'View', desc: kodo.summary, meta: [['Since', kodo.start], ['Formerly', kodo.formerly ?? '—']] },
  { id: 'c-projects', title: 'Browse Projects', icon: 'code', kw: 'repos side open source github code', act: 'view:projects', label: 'Open Projects', alt: 'jump:projects', altLabel: 'Show Widget', acc: `${repos.length}`, kind: 'View', desc: `Things I build to learn — lately ${langs.join(', ')}. Live from GitHub, most recently pushed first.`, meta: repos.slice(0, 4).map((p) => [p.name, p.updated || p.lang]) },
  { id: 'w-now', title: 'Go to Now', sub: 'What I’m up to', icon: 'sparkles', kw: 'building learning shooting current', act: 'jump:now', label: 'Show Widget', kind: 'Widget', desc: 'A /now page, as a widget.', meta: Object.entries(profile.now).map(([k, v]) => [k[0].toUpperCase() + k.slice(1), v]) },
  { id: 'w-golden', title: 'Go to Golden Hour', sub: `${cam.body} · 35mm f/1.4 GM`, icon: 'sunMax', kw: 'sunset photography light sun camera sony lens shooting photos', act: 'jump:golden', label: 'Show Widget', kind: 'Widget', desc: `When I’m not shipping, I’m usually on the coast with the ${cam.body} and ${cam.lens}, waiting for the sun to drop below 6°.`, meta: [['Golden hour', '—'], ['Sunset', '—'], ['Body', cam.body], ['Lens', cam.lens]] },
  { id: 'w-terminal', title: 'Go to Terminal', sub: 'An honest little zsh', icon: 'terminal', kw: 'shell cli command zsh', act: 'jump:terminal', label: 'Show Widget', alt: 'term:help', altLabel: 'Run help', kind: 'Widget', desc: 'Type help. Tab completes, ↑ ↓ for history, ⌃L clears.', meta: [['Shell', 'zsh'], ['Try', 'sudo hire josh']] },
  { id: 'w-commits', title: 'Go to Commits', sub: 'A year on GitHub', icon: 'chart', kw: 'stocks chart contributions github activity', act: 'jump:commits', label: 'Show Widget', kind: 'Widget', desc: 'Real numbers, fetched when the site was built.', meta: [['This year', n(gh.total)], ['Last 30 days', n(gh.last30)], ['Busiest week', n(busiest)]] },
  { id: 'w-github', title: 'Go to Contributions', sub: 'Heatmap', icon: 'github', kw: 'github graph heatmap activity', act: 'jump:github', label: 'Show Widget', alt: `href:${gitHub.href}`, altLabel: 'Open GitHub', kind: 'Widget', desc: 'Day-job platforms, plus weekend side projects.', meta: [['Contributions', n(gh.total)], ['Streak', `${gh.streak} days`]] },
];
const contact: Cmd[] = [
  { id: 'c-email', title: 'Email Josh', sub: email, icon: 'mail', kw: 'contact hire message mail', act: 'mail', label: 'Open Mail', alt: 'copy:email', altLabel: 'Copy Email', desc: 'Usually replies within a day.', meta: [['To', email]] },
  { id: 'c-copy', title: 'Copy Email Address', icon: 'copy', kw: 'clipboard contact', act: 'copy:email', label: 'Copy to Clipboard', desc: 'Straight to your clipboard.', meta: [['Email', email]] },
  { id: 'c-coffee', title: 'Book a Coffee', sub: 'Sydney CBD', icon: 'coffee', kw: 'meet chat calendar availability', act: 'coffee:pick', label: 'Pick a Morning', alt: 'coffee:mail', altLabel: 'Ask for the Next Free Morning', desc: 'Weekday mornings in Sydney, or a call from anywhere.', meta: coffeeMeta },
  { id: 'c-github', title: 'Open GitHub', sub: gitHub.handle, icon: 'github', kw: 'code repos profile', act: `href:${gitHub.href}`, label: 'Open in Browser', alt: 'copy:github', altLabel: 'Copy Link', desc: 'Repos, stars and the occasional half-finished idea.', meta: [['Profile', gitHub.href.replace('https://', '')]] },
  { id: 'c-linkedin', title: 'Open LinkedIn', sub: linkedIn.handle, icon: 'linkedin', kw: 'profile cv network', act: `href:${linkedIn.href}`, label: 'Open in Browser', desc: 'The formal version.', meta: [['Profile', linkedIn.href.replace('https://', '')]] },
  { id: 'c-x', title: 'Open X', sub: x.handle, icon: 'x', kw: 'twitter social', act: `href:${x.href}`, label: 'Open in Browser', desc: 'Occasionally.', meta: [['Profile', x.href.replace('https://', '')]] },
];
const system: Cmd[] = [
  { id: 'c-bg', title: 'Next Backdrop', sub: 'Dunes · Dusk · Night · Black · Dots', icon: 'contrast', kw: 'theme background wallpaper appearance dark', act: 'bg', label: 'Change Backdrop', kind: 'Command', desc: 'Cycles the backdrop behind the page. Also bottom-right; remembered for next time.', meta: [['Current', '—']] },
  { id: 'c-whoami', title: 'whoami', sub: 'Run in Terminal', icon: 'terminal', kw: 'about bio terminal shell', act: 'term:whoami', label: 'Run in Terminal', kind: 'Terminal', desc: 'The short version, typed out for you.', meta: [['Command', 'whoami']] },
  { id: 'c-hire', title: 'sudo hire josh', sub: 'Run in Terminal', icon: 'terminal', kw: 'job recruit terminal', act: 'term:sudo hire josh', label: 'Run in Terminal', kind: 'Terminal', desc: 'Requires a password. Probably.', meta: [['Command', 'sudo hire josh']] },
];
const rootSections = [
  { title: 'Suggestions', items: suggestions as Cmd[], empty: true },
  { title: 'Navigate', items: navigate, empty: false },
  { title: 'Contact', items: contact, empty: false },
  { title: 'System', items: system, empty: false },
];
const kindOf = (c: Cmd) => c.kind ?? (c.act.startsWith('href') ? 'Link' : c.act.startsWith('term') ? 'Terminal' : 'Command');

const backdrops = [
  { id: 'dunes', label: 'Dunes' },
  { id: 'dusk', label: 'Dusk' },
  { id: 'night', label: 'Night' },
  { id: 'black', label: 'Black' },
  { id: 'dots', label: 'Dots' },
];
---

<Base title="Josh Germon" description="Josh Germon — founding engineer at Kodo, in Sydney. Notes, photos and small tools, all one command away with ⌘K." theme="dark" class="cb">
  <script is:inline slot="head">
    (function () {
      var d = document.documentElement, ok = ['dunes', 'dusk', 'night', 'black', 'dots'], b = null;
      d.setAttribute('data-js', '');
      try {
        b = new URLSearchParams(location.search).get('bg');
        if (ok.indexOf(b) < 0) b = localStorage.getItem('cb-bg');
      } catch (e) {}
      d.setAttribute('data-bg', ok.indexOf(b) < 0 ? 'dusk' : b);
    })();
  </script>

  <!-- Backdrops (Editorial): blurred photographs or dots, cross-faded, plus grain. -->
  <div class="cb-bg" aria-hidden="true">
    <div class="cb-bg-l" data-bg-l="dunes"><img class="cb-bg-photo" src="/wallpapers/dunes-dark-1200.jpg" alt="" decoding="async" fetchpriority="low" /></div>
    <div class="cb-bg-l" data-bg-l="dusk"><img class="cb-bg-photo" src="/wallpapers/dunes-1200.jpg" alt="" decoding="async" fetchpriority="high" /></div>
    <div class="cb-bg-l" data-bg-l="night"><img class="cb-bg-photo" src="/wallpapers/dunes-dark-1200.jpg" alt="" decoding="async" fetchpriority="low" /></div>
  </div>
  <canvas class="cb-dots" data-bg-l="dots" aria-hidden="true"></canvas>
  <div class="cb-grain" aria-hidden="true"></div>

  <!-- Top bar: who, and the one way to get anywhere. -------------------------- -->
  <header class="top" data-top>
    <a class="top-id" href="#" data-totop aria-label="Josh Germon — back to top">
      <img src="/me/memoji.jpg" alt="" width="28" height="28" />
      <span>Josh Germon</span>
    </a>
    <button class="top-cmd" type="button" data-open data-bar aria-haspopup="dialog" aria-label="Open command palette">
      <span class="top-cmd-ic"><Ico name="command" size={14} stroke={2} /></span>
      <span class="top-cmd-ph">What would you like to do?</span>
      <span class="top-cmd-k"><kbd>⌘</kbd><kbd>K</kbd></span>
    </button>
    <span class="top-clock"><span data-syd-now>—</span> in Sydney</span>
  </header>

  <!-- Backdrop switcher (Editorial). Desktop: swatches. Phone: one button → sheet. -->
  <div class="bgs" role="radiogroup" aria-label="Backdrop">
    <span class="bgs-l" data-bgs-label aria-hidden="true">Dusk</span>
    {backdrops.map((b) => (
      <button type="button" role="radio" class={`bgs-sw bgs-sw--${b.id}`} data-bg-pick={b.id} aria-checked="false" aria-label={b.label} title={b.label}></button>
    ))}
  </div>
  <button type="button" class="bgs-m" data-bgs-open aria-haspopup="dialog" aria-label="Change backdrop">
    <i class="bgs-m-sw" aria-hidden="true"></i><span data-bg-now>Dusk</span>
  </button>

  <main class="cb-main">
    <!-- Hero (Editorial) ------------------------------------------------------ -->
    <section class="hero" aria-labelledby="hero-h">
      <h1 class="sr" id="hero-h">Josh Germon</h1>
      <p class="lede">
        {tokens.map((tk) =>
          tk.t === 'w' ? (
            <><span class="w" style={`--i:${tk.i}`}>{tk.s}</span>{' '}</>
          ) : (
            <><span class="w w--pill" style={`--i:${tk.i}`}><a
                class="pill"
                href={`#${tk.p.to}`}
                data-pill={tk.p.key}
                data-to={tk.p.to}
                data-act={tk.p.act}
                data-cta={tk.p.cta}
                data-title={tk.p.title}
                data-pass={tk.p.pass}
              >{tk.p.avatar && <img class="pill-av" src="/me/memoji.jpg" alt="" width="40" height="40" />}{tk.p.dot && <i class="pill-dot" style={`--d:${tk.p.dot}`}></i>}{tk.p.pill}</a>{tk.tail}</span>{' '}</>
          ),
        )}
      </p>
      <nav class="acts" aria-label="Suggested commands">
        {suggestions.map((c) => (
          <button type="button" class="chip" data-act={c.act} data-sugg aria-keyshortcuts={`Alt+${c.keys![1]}`}>
            <Ico name={c.icon} size={13} />
            <span>{c.chip}</span>
            <span class="chip-k"><kbd>⌥</kbd><kbd>{c.keys![1]}</kbd></span>
          </button>
        ))}
        <span class="acts-or">or just start typing</span>
      </nav>
    </section>

    <!-- Bento (Command) ------------------------------------------------------- -->
    <div class="grid">
      <!-- Notes -->
      <section class="bx bx--notes" id="notes" data-w="notes">
        <header class="bx-h">
          <span class="ic"><Ico name="folder" size={13} /></span>
          <button class="bx-t bx-open" type="button" data-act="view:notes">Notes</button>
          <span class="bx-s">{notes.length}</span>
          <span class="bx-hint"><kbd>↵</kbd> Open</span>
        </header>
        <button class="nt-top" type="button" data-act={`view:notes@note-${latest.id}!`}>
          <time datetime={latest.data.date.toISOString()}>{fmt(latest.data.date, { day: 'numeric', month: 'long', year: 'numeric' })}</time>
          <b>{latest.data.excerpt}</b>
          <p>{plain(latest.body).slice(0, 170)}…</p>
        </button>
        <ul class="rows">
          {notes.slice(1, 5).map((nn) => (
            <li>
              <button class="row" type="button" data-act={`view:notes@note-${nn.id}!`}>
                <span class="ic ic--ghost"><Ico name="note" size={13} /></span><b>{nn.data.excerpt}</b><span class="row-a">{fmt(nn.data.date, { day: 'numeric', month: 'short' })}</span>
              </button>
            </li>
          ))}
        </ul>
      </section>

      <!-- Engineering: Editorial's switching stack, Command's passes -->
      <section class="bx bx--wallet" id="engineering" data-w="engineering">
        <header class="bx-h">
          <span class="ic"><Ico name="wallet" size={13} /></span>
          <button class="bx-t bx-open" type="button" data-act="view:career">Engineering</button>
          <span class="bx-s">{career.length} roles</span>
          <span class="bx-hint"><kbd>↵</kbd> Open</span>
        </header>
        <div class="wal">
          <ol class="wal-stack" data-wal style={`--n:${career.length}`}>
            {career.map((r, k) => (
              <li class="wal-slot" data-i={k}>
                <button type="button" class="wal-hit" data-wal-pick={k} aria-label={`${r.title}, ${r.company}`}>
                  <Pass role={r} />
                </button>
              </li>
            ))}
          </ol>
          <div class="wal-cap">
            {career.map((r, k) => (
              <div class="wal-info" data-i={k} hidden={k !== 0}>
                <p class="wal-k"><b>{r.title}</b><span class="wal-y">{r.years.replace(' — ', '–')}</span></p>
                <p class="wal-c">{r.company}{r.formerly && <> · formerly {r.formerly}</>} · {r.kind}</p>
                <p class="wal-s">{r.summary}</p>
              </div>
            ))}
            <ol class="wal-tabs" role="tablist" aria-label="Roles">
              {career.map((r, k) => (
                <li>
                  <button type="button" role="tab" data-wal-pick={k} aria-selected={k === 0 ? 'true' : 'false'}>
                    <i style={`background:${brandOf(r.company).bg}`}></i>{r.company.replace(' Design', '')}
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- Now -->
      <section class="bx bx--now" id="now" data-w="now">
        <header class="bx-h"><span class="ic"><Ico name="sparkles" size={13} /></span><span class="bx-t">Now</span><span class="bx-s">Nov 2026</span></header>
        <dl class="now">
          <div><dt><Ico name="hammer" size={12} /> Building</dt><dd>{profile.now.building}</dd></div>
          <div><dt><Ico name="book" size={12} /> Learning</dt><dd>{profile.now.learning}</dd></div>
          <div><dt><Ico name="camera" size={12} /> Shooting</dt><dd>{profile.now.shooting}</dd></div>
        </dl>
      </section>

      <!-- Coffee: Editorial's fortnight -->
      <section class="bx bx--coffee" id="coffee" data-w="coffee">
        <header class="bx-h">
          <span class="ic"><Ico name="coffee" size={13} /></span><span class="bx-t">Grab a coffee</span>
        </header>
        <p class="cf-mo"><b data-cf-month>{cf.month}</b><span>Mornings · Sydney</span></p>
        <div class="cf-cal">
          <div class="cf-wk" aria-hidden="true"><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span></div>
          <div class="cf-grid" role="group" aria-label="Pick a weekday morning" data-cf-grid set:html={coffeeGrid(cf.days, cf.first.iso)} />
        </div>
        <p class="cf-hint">Pick a morning — it drafts the email.</p>
        <a class="cf-cta" data-cf-cta href={coffeeHref(email, cf.first)}>
