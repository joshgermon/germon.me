---
/**
 * Scrapbook · Gallery wall.
 * Josh's work hung as an exhibition on one long gallery wall you walk along:
 * lime-plaster wall, track spots, real-depth box frames whose glazing catches
 * the light as you move, a face-mounted acrylic hero that genuinely refracts,
 * a floating shelf of objects, a salon hang of notes. Select a work to step
 * closer and read its label.
 */
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/geist-mono';
import '@/concepts/scrapbook-gallery/gallery.css';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import TabBar from '@/components/TabBar.astro';
import Frame from '@/concepts/scrapbook-gallery/Frame.astro';
import Tombstone from '@/concepts/scrapbook-gallery/Tombstone.astro';
import ShelfObject from '@/concepts/scrapbook-gallery/ShelfObject.astro';
import Tpl from '@/concepts/scrapbook-gallery/Tpl.astro';
import NoteBody from '@/concepts/scrapbook-gallery/NoteBody.astro';
import { profile, career, stats, projects, photos } from '@/data/profile';

// ---------------------------------------------------------------- notes
const plain = (s: string) =>
  s
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 12)
  .map((n) => {
    const paras = (n.body ?? '')
      .split(/\n\s*\n/)
      .map((p) => p.trim())
      .filter((p) => p && !p.startsWith('#') && !p.startsWith('---') && !p.startsWith('```'))
      .map(plain);
    const d = n.data.date;
    const date = `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
    return { id: n.id, title: n.data.excerpt, date, paras: paras.slice(0, 4), snippet: paras.slice(0, 2).join(' ') };
  });
const noteCount = (await getCollection('notes')).length;

// ---------------------------------------------------------------- layout
// One long wall. World units are px at zoom 1. Eye-line sits at y≈640.
const H = 1500;
const EYE = 680;
type Spot = { x: number; w: number };
const spots: Spot[] = [];
const spot = (x: number, w: number) => spots.push({ x, w });

// Room 1 — Introduction
const hero = photos[0];
const heroBox = { x: 1330, y: 470, w: 630, h: 420 };
const nowBox = { x: 2090, y: 505, w: 270, h: 350 };
spot(380, 820);
spot(860, 820);
spot(heroBox.x + heroBox.w / 2, 980);
spot(nowBox.x + nowBox.w / 2, 560);

// Room 2 — Career
const R2 = 2560;
const roleBoxes = [
  { x: R2 + 640, y: 340, w: 500, h: 680, finish: 'black' as const, face: 18, mat: 58, depth: 12 },
  { x: R2 + 1250, y: 410, w: 430, h: 560, finish: 'oak' as const, face: 22, mat: 46, depth: 12 },
  { x: R2 + 1790, y: 465, w: 360, h: 450, finish: 'white' as const, face: 18, mat: 40, depth: 10 },
];
spot(R2 + 330, 640);
roleBoxes.forEach((b) => spot(b.x + b.w / 2, b.w + 420));

// Room 3 — Tools & objects
const R3 = R2 + 2360;
const rqBox = { x: R3 + 640, y: 440, w: 700, h: 500 };
// Two floating shelves, three objects each.
const shelves = [
  { x: R3 + 1450, y: 640, w: 680 },
  { x: R3 + 1450, y: 1030, w: 680 },
];
const shelfItems: { kind: 'tape' | 'box' | 'sign' | 'books' | 'hourglass' | 'bell'; w: number; h: number; s: number; dx: number; year: string }[] = [
  // TODO(josh): real years
  { kind: 'tape', w: 132, h: 124, s: 0, dx: 46, year: '2024' },
  { kind: 'box', w: 184, h: 112, s: 0, dx: 248, year: '2023' },
  { kind: 'sign', w: 156, h: 112, s: 0, dx: 488, year: '2022' },
  { kind: 'books', w: 230, h: 200, s: 1, dx: 40, year: '2022' },
  { kind: 'hourglass', w: 100, h: 176, s: 1, dx: 318, year: '2023' },
  { kind: 'bell', w: 132, h: 106, s: 1, dx: 512, year: '2024' },
];
spot(R3 + 330, 640);
spot(rqBox.x + rqBox.w / 2, 1000);
spot(shelves[0].x + shelves[0].w / 2, 980);

// Room 4 — Photographs: a single line hang, centred on the eye-line.
const R4 = R3 + 2300;
const PH_FACE = 16;
const PH_DEPTH = 8;
const PH_MAT = 44;
const PH_BEVEL = 4;
const edge = PH_FACE + PH_DEPTH + PH_MAT + PH_BEVEL;
const photoFinishes = ['black', 'oak', 'black', 'white', 'black', 'walnut', 'black'] as const;
const photoYears = ['2025', '2024', '2025', '2023', '2024', '2025', '2024']; // TODO(josh)
let px = R4 + 700;
const hang = photos.slice(1).map((p, i) => {
  const portrait = p.h > p.w;
  const iw = portrait ? 236 : 336;
  const ih = Math.round((iw * p.h) / p.w);
  const w = iw + edge * 2;
  const h = ih + edge * 2;
  const box = { x: px, y: Math.round(EYE - h / 2), w, h, p, finish: photoFinishes[i % photoFinishes.length], year: photoYears[i] };
  px += w + 86;
  spot(box.x + w / 2, w + 300);
  return box;
});
spot(R4 + 330, 640);
const R5 = px + 160;

// Room 5 — Notes, salon hang.
const SALON = { x: R5 + 640, y: 250 };
type Slot = [number, number, number, number, 'sheet' | 'black' | 'oak' | 'white' | 'walnut'];
const slots: Slot[] = [
  [0, 0, 300, 380, 'black'],
  [0, 420, 300, 236, 'sheet'],
  [0, 696, 300, 300, 'oak'],
  [340, 64, 260, 200, 'sheet'],
  [340, 304, 260, 340, 'white'],
  [340, 684, 260, 250, 'sheet'],
  [640, 0, 360, 280, 'black'],
  [640, 320, 360, 420, 'sheet'],
  [640, 780, 360, 190, 'walnut'],
  [1040, 84, 240, 300, 'sheet'],
  [1040, 424, 240, 260, 'black'],
  [1040, 724, 240, 230, 'sheet'],
];
spot(R5 + 330, 640);
spot(SALON.x + 300, 900);
spot(SALON.x + 980, 900);
const END = { x: SALON.x + 1280 + 260, y: 420 };
spot(END.x + 240, 760);
const W = END.x + 720;

const rooms = [
  { id: 'about', n: 1, name: 'Introduction', x0: 0, x1: R2, cx: 1265, mcx: 390 },
  { id: 'work', n: 2, name: 'Career', x0: R2, x1: R3, cx: R2 + 1220, mcx: R2 + 330 },
  { id: 'projects', n: 3, name: 'Tools & objects', x0: R3, x1: R4, cx: R3 + 1150, mcx: R3 + 330 },
  { id: 'photos', n: 4, name: 'Photographs', x0: R4, x1: R5, cx: R4 + 1130, mcx: R4 + 330 },
  { id: 'notes', n: 5, name: 'Notes', x0: R5, x1: W, cx: R5 + 1240, mcx: R5 + 330 },
];
const piers = [-60, ...rooms.slice(1).map((r) => r.x0), W + 60];

const pos = (x: number, y: number, extra = '') => `left:${x}px;top:${y}px;${extra}`;
const yearOf = (years: string) => years.split('—')[0].trim();
const tabs = [
  { label: 'About', href: '#to-about', icon: 'person' as const },
  { label: 'Work', href: '#to-work', icon: 'briefcase' as const },
  { label: 'Projects', href: '#to-projects', icon: 'code' as const },
  { label: 'Photographs', href: '#to-photos', icon: 'camera' as const },
  { label: 'Notes', href: '#to-notes', icon: 'note' as const },
];
const projectObjects = projects.slice(1);
const termHtml = `<span class="p">$</span> rq --spec openapi.yaml
<span class="d">  loaded 24 operations · payments v1.4</span>

<span class="sel">  ▸ GET     /payments            listPayments    </span>
    POST    /payments            createPayment
    GET     /payments/{id}       getPayment
    POST    /payments/{id}/refund refundPayment

<span class="p">$</span> rq send listPayments --limit 2
<span class="ok">  200 OK</span><span class="d"> · 41 ms · 612 B</span>
  [{ "id": "pay_1Nq", "amount": 4200 }, …]<span class="cur"> </span>`;
---
<Base title="Load-bearing — Joshua Germon" theme="light" class="gw">
  <div class="gw-viewport" aria-label="Exhibition wall — drag to walk along it">
    <div class="gw-world" style={`width:${W}px;height:${H}px;`} data-w={W} data-h={H}>
      <!-- Architecture --------------------------------------------------- -->
      <div class="gw-wall" aria-hidden="true"></div>
      <div class="gw-spots" aria-hidden="true">
        {spots.map((s, i) => (
          <i class="gw-spot" style={`left:${s.x - s.w / 2}px;width:${s.w}px;--i:${i};`}></i>
        ))}
      </div>
      <div class="gw-ceiling" aria-hidden="true">
        <span class="gw-track"></span>
        {spots.map((s, i) => (
          <span class="gw-fixture" style={`left:${s.x}px;--i:${i};--tilt:${(i % 3) - 1}`}><i></i></span>
        ))}
      </div>
      <div class="gw-floor" aria-hidden="true">
        {spots.map((s) => <i class="gw-floor-glow" style={`left:${s.x - s.w * 0.35}px;width:${s.w * 0.7}px;`}></i>)}
      </div>
      {piers.map((x) => <div class="gw-pier" style={`left:${x - 34}px`} aria-hidden="true"></div>)}

      <!-- ============================ 1 · INTRODUCTION ===================== -->
      <section class="gw-room" data-room="about" data-x0={rooms[0].x0} data-x1={rooms[0].x1} data-cx={rooms[0].cx} data-mcx={rooms[0].mcx} aria-label="Gallery 1, Introduction">
        <header class="gw-title" style={pos(170, 272, '--mx:110px;--my:220px;')}>
          <p class="tt-name">{profile.name}</p>
          <h1 class="tt-show"><span>Load-</span><span>bearing</span></h1>
          <p class="tt-sub">Software, systems &amp; photographs, <span class="nw">2017&#8202;—&#8202;2026</span></p>
          <div class="tt-text">
            <p>
              {profile.name} is a staff software engineer based in Sydney. For nine years he has worked on the parts of
              software that other software stands on&#8202;—&#8202;platforms, payments, authentication&#8202;—&#8202;and on making
              those parts feel effortless to the people who build on them.
            </p>
            <p>
              This exhibition hangs that work alongside the things made around it: small tools for the terminal, photographs
              taken on weekends, and a run of daily notes. Five galleries, left to right. Select any work to step closer.
            </p>
          </div>
          <dl class="tt-meta">
            <div><dt>Role</dt><dd>{profile.title}</dd></div>
            <div><dt>Based</dt><dd>{profile.location}</dd></div>
            <div>
              <dt>Enquiries</dt>
              <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
            </div>
          </dl>
          <nav class="tt-plan" aria-label="Plan of the exhibition">
            <p class="tt-plan-k">Plan of the exhibition</p>
            <ol>
              {rooms.map((r) => (
                <li style={`flex-grow:${r.x1 - r.x0}`}>
                  <button type="button" data-fly={r.id}>
                    <span class="pl-n">{r.n}</span>
                    <span class="pl-name">{r.name}</span>
                    {r.n === 1 && <span class="pl-here">You are here</span>}
                  </button>
                </li>
              ))}
            </ol>
          </nav>
        </header>

        <!-- Hero: face-mounted acrylic — the glazing actually refracts. -->
        <article class="gw-piece gw-diasec" data-id="hero" style={pos(heroBox.x, heroBox.y, `width:${heroBox.w}px;height:${heroBox.h}px;--mx:860px;--my:${heroBox.y}px;`)}>
          <div class="dia-print"><img src={hero.src} alt={hero.caption} width={hero.w} height={hero.h} loading="eager" decoding="async" draggable="false" /></div>
          <liquid-glass class="dia-glass" radius="5" bezel="76" refraction="70" dispersion="0.015" profile="circle" blur="0" aria-hidden="true"></liquid-glass>
          <div class="gw-label lbl-below">
            <Tombstone title={hero.caption} year="2025" medium="Pigment print face-mounted to 12 mm acrylic" acc="JG.2025.P01" />
          </div>
          <Tpl class="gw-more">
            <p class="cd-chat">
              The only piece in the show behind acrylic rather than glass. Face-mounting bonds the print to a thick block, so the
              edges bend the image like water at the rim of a glass. Move closer and watch the corners.
            </p>
            <p class="cd-meta">{profile.now.shooting}</p>
          </Tpl>
          <button class="gw-hit" type="button" aria-label={`Step closer to ${hero.caption}`}></button>
        </article>

        <Frame id="now" name="Currently" x={nowBox.x} y={nowBox.y} w={nowBox.w} h={nowBox.h} finish="white" face={14} mat={26} depth={8}>
          <div class="lp lp-now">
            <p class="lp-kicker">Currently</p>
            <dl>
              <dt>Building</dt><dd>{profile.now.building}</dd>
              <dt>Learning</dt><dd>{profile.now.learning}</dd>
              <dt>Shooting</dt><dd>{profile.now.shooting}</dd>
            </dl>
          </div>
          <Fragment slot="label"><Tombstone title="Currently" year="2026" medium="Letterpress on cotton card" detail="Updated irregularly" /></Fragment>
          <Fragment slot="card">
            <dl class="cd-list">
              <dt>Building</dt><dd>{profile.now.building}</dd>
              <dt>Learning</dt><dd>{profile.now.learning}</dd>
              <dt>Shooting</dt><dd>{profile.now.shooting}</dd>
            </dl>
            <ul class="cd-links">
              {profile.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label} <span>{s.handle}</span></a></li>)}
              <li><a href={`mailto:${profile.email}`}>Email <span>{profile.email}</span></a></li>
            </ul>
          </Fragment>
        </Frame>
      </section>

      <!-- ============================ 2 · CAREER =========================== -->
      <section class="gw-room" data-room="work" data-x0={rooms[1].x0} data-x1={rooms[1].x1} data-cx={rooms[1].cx} data-mcx={rooms[1].mcx} aria-label="Gallery 2, Career">
        <div class="gw-panel" style={pos(R2 + 150, 336)}>
          <p class="pn-no">Gallery 2</p>
          <h2 class="pn-title">Career</h2>
          <p class="pn-dates">2017&#8202;—&#8202;Now</p>
          <p class="pn-body">
            Three roles, hung in order. The early work is quick and plural: forty-odd launches at an agency. The later work
            slows down and gets heavier&#8202;—&#8202;payments, authentication, a platform other engineers build on. Throughout,
            a preference for the parts nobody notices until they fail.
          </p>
          <dl class="pn-stats">
            {stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
          </dl>
        </div>

        {career.slice(0, roleBoxes.length).map((r, i) => {
          const b = roleBoxes[i];
          const [from, to] = r.years.split('—').map((s) => s.trim());
          return (
            <Frame id={`role-${i}`} name={r.title} x={b.x} y={b.y} w={b.w} h={b.h} finish={b.finish} face={b.face} mat={b.mat} depth={b.depth}>
              <div class:list={['lp', 'lp-role', `lp-${i}`]}>
                <div class="lp-top"><span>No. {i + 1}</span><span class="tnum">{from}&#8202;—&#8202;{to}</span></div>
                {i === 1 ? (
                  <Fragment>
                    <p class="lp-years tnum">{from}<span>/</span>{to.slice(-2)}</p>
                    <h3 class="lp-title">{r.title}</h3>
                  </Fragment>
                ) : i === 2 ? (
                  <Fragment>
                    <p class="lp-years tnum">{from}</p>
                    <h3 class="lp-title">{r.title}</h3>
                  </Fragment>
                ) : (
                  <h3 class="lp-title">{r.title.split(' ').map((w) => <span>{w}</span>)}</h3>
                )}
                <p class="lp-co">{r.company}</p>
                {i === 0 && (
                  <ol class="lp-hl">{r.highlights.map((h) => <li>{h}</li>)}</ol>
                )}
                <p class="lp-stack">{r.stack.slice(0, i === 0 ? 6 : 4).join(' · ')}</p>
              </div>
              <Fragment slot="label">
                <Tombstone title={r.title} year={`${from}–${to === 'Now' ? 'present' : to}`} medium={r.company} detail={r.stack.slice(0, 4).join(', ')} acc={`JG.${yearOf(r.years)}.C0${i + 1}`} />
              </Fragment>
              <Fragment slot="card">
                <p class="cd-chat">{r.summary}</p>
                <ul class="cd-hl">{r.highlights.map((h) => <li>{h}</li>)}</ul>
                <p class="cd-meta">{r.stack.join(' · ')}</p>
              </Fragment>
            </Frame>
          );
        })}
      </section>

      <!-- ============================ 3 · TOOLS & OBJECTS ================== -->
      <section class="gw-room" data-room="projects" data-x0={rooms[2].x0} data-x1={rooms[2].x1} data-cx={rooms[2].cx} data-mcx={rooms[2].mcx} aria-label="Gallery 3, Tools and objects">
        <div class="gw-panel" style={pos(R3 + 150, 336)}>
          <p class="pn-no">Gallery 3</p>
          <h2 class="pn-title">Tools &amp; objects</h2>
          <p class="pn-dates">Open source, 2022&#8202;—&#8202;2025</p>
          <p class="pn-body">
            Side projects, mostly small, mostly for the terminal. Each one scratched a specific itch: a backup that runs
            itself, an HTTP server from bare sockets, an interpreter written to understand interpreters. On the shelves, an
            object stands in for each.
          </p>
          <p class="pn-foot"><a href="https://github.com/joshgermon" target="_blank" rel="noopener">github.com/joshgermon ↗</a></p>
        </div>

        <Frame id="rq" name={projects[0].name} x={rqBox.x} y={rqBox.y} w={rqBox.w} h={rqBox.h} finish="black" face={18} mat={50} depth={12}>
          <div class="term" aria-hidden="true">
            <div class="term-bar"><i></i><i></i><i></i><span>rq — ~/work/payments-api</span></div>
            <pre class="term-body" set:html={termHtml}></pre>
          </div>
          <Fragment slot="label">
            <Tombstone title={projects[0].name} year="2025" medium={`${projects[0].lang}, OpenAPI`} detail="Terminal client" acc="JG.2025.T01" />
          </Fragment>
          <Fragment slot="card">
            <p class="cd-chat">{projects[0].blurb}</p>
            <p class="cd-meta">Currently building · {projects[0].lang}</p>
            <ul class="cd-links"><li><a href={projects[0].href} target="_blank" rel="noopener">Source <span>github.com/joshgermon/rq ↗</span></a></li></ul>
          </Fragment>
        </Frame>

        {shelves.map((sh) => <div class="gw-shelf" style={pos(sh.x, sh.y, `width:${sh.w}px;`)} aria-hidden="true"></div>)}
        {projectObjects.map((p, i) => {
          const it = shelfItems[i];
          return (
            <article class="gw-piece gw-object" data-id={`obj-${p.name}`} data-kind={it.kind} style={pos(shelves[it.s].x + it.dx, shelves[it.s].y - it.h + 2, `width:${it.w}px;height:${it.h}px;`)}>
              <ShelfObject kind={it.kind} />
              <div class="gw-label lbl-shelf">
                <Tombstone no={String(i + 1)} title={p.name} year={it.year} medium={p.lang} />
              </div>
              <Tpl class="gw-more">
                <p class="cd-chat">{p.blurb}</p>
                <ul class="cd-links"><li><a href={p.href} target="_blank" rel="noopener">Source <span>{p.href.replace('https://', '')} ↗</span></a></li></ul>
              </Tpl>
              <button class="gw-hit" type="button" aria-label={`Step closer to ${p.name}`}></button>
            </article>
          );
        })}
      </section>

      <!-- ============================ 4 · PHOTOGRAPHS ====================== -->
      <section class="gw-room" data-room="photos" data-x0={rooms[3].x0} data-x1={rooms[3].x1} data-cx={rooms[3].cx} data-mcx={rooms[3].mcx} aria-label="Gallery 4, Photographs">
        <div class="gw-panel" style={pos(R4 + 150, 336)}>
          <p class="pn-no">Gallery 4</p>
          <h2 class="pn-title">Photographs</h2>
          <p class="pn-dates">Weekends, 2023&#8202;—&#8202;2025</p>
          <p class="pn-body">
            Made on days off with one camera and one lens, mostly around Sydney and the Blue Mountains. Hung in a single line
            at eye level, in the order they were taken. The light here is the same light as the rest of the show.
          </p>
          <p class="pn-foot">{profile.now.shooting}</p>
        </div>
        {hang.map((b, i) => (
          <Frame id={`photo-${i}`} name={b.p.caption} x={b.x} y={b.y} w={b.w} h={b.h} finish={b.finish} face={PH_FACE} mat={PH_MAT} depth={PH_DEPTH}>
            <img class="ph" src={b.p.src} alt={b.p.caption} width={b.p.w} height={b.p.h} loading="lazy" decoding="async" draggable="false" />
            <Fragment slot="label">
              <Tombstone title={b.p.caption} year={b.year} medium="Pigment print on cotton rag" acc={`JG.${b.year}.P0${i + 2}`} />
            </Fragment>
            <Fragment slot="card">
              <p class="cd-meta">{profile.now.shooting}</p>
            </Fragment>
          </Frame>
        ))}
      </section>

      <!-- ============================ 5 · NOTES ============================ -->
      <section class="gw-room" data-room="notes" data-x0={rooms[4].x0} data-x1={rooms[4].x1} data-cx={rooms[4].cx} data-mcx={rooms[4].mcx} aria-label="Gallery 5, Notes">
        <div class="gw-panel" style={pos(R5 + 150, 336)}>
          <p class="pn-no">Gallery 5</p>
          <h2 class="pn-title">Notes</h2>
          <p class="pn-dates">August&#8202;—&#8202;September 2022</p>
          <p class="pn-body">
            {noteCount} short pieces, written one a day. Twelve are hung here salon-style, the way they were written: close
            together, unevenly sized, some framed and some simply pinned. Select one to read it.
          </p>
        </div>
        {notes.map((n, i) => {
          const [dx, dy, w, h, kind] = slots[i];
          const x = SALON.x + dx;
          const y = SALON.y + dy;
          const size = w * h > 120000 ? 'lg' : w * h > 70000 ? 'md' : 'sm';
          return kind === 'sheet' ? (
            <article class="gw-piece gw-sheet" data-id={`note-${n.id}`} style={pos(x, y, `width:${w}px;height:${h}px;--r:${((i * 37) % 7) / 10 - 0.3}deg;`)}>
              <i class="pin l"></i><i class="pin r"></i>
              <NoteBody date={n.date} title={n.title} snippet={n.snippet} size={size} />
              <Tpl class="gw-more">{n.paras.map((p) => <p class="cd-chat">{p}</p>)}</Tpl>
              <Tpl class="gw-tomb"><Tombstone title={n.title.replace(/\.$/, '')} year={n.date} medium="Ink on paper, pinned" /></Tpl>
              <button class="gw-hit" type="button" aria-label={`Read note: ${n.title}`}></button>
            </article>
          ) : (
            <Frame id={`note-${n.id}`} name={n.title} x={x} y={y} w={w} h={h} finish={kind} face={12} mat={20} depth={6} label="none">
              <NoteBody date={n.date} title={n.title} snippet={n.snippet} size={size} />
              <Fragment slot="tomb"><Tombstone title={n.title.replace(/\.$/, '')} year={n.date} medium="Ink on paper, framed" /></Fragment>
              <Fragment slot="card">{n.paras.map((p) => <p class="cd-chat">{p}</p>)}</Fragment>
            </Frame>
          );
        })}

        <div class="gw-end" style={pos(END.x, END.y)}>
          <p class="pn-no">Exit</p>
          <h2 class="end-title">Thank you<br />for visiting.</h2>
          <p class="end-body">The exhibition continues online. Enquiries, collaborations and conversations welcome.</p>
          <ul class="end-links">
            <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
            {profile.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}<span>{s.handle}</span></a></li>)}
          </ul>
          <button class="end-again" type="button" data-fly="about">Return to the beginning</button>
        </div>
      </section>
    </div>
  </div>

  <!-- Floating layer --------------------------------------------------- -->
  <a class="gw-back" href="/concepts" aria-label="All concepts">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <span>Concepts</span>
  </a>
  <p class="gw-hint" role="status">Drag to walk the wall&ensp;·&ensp;select a work to step closer</p>

  <aside class="gw-card" aria-hidden="true" aria-label="Work label">
    <div class="cd-head">
      <p class="cd-room"></p>
      <button class="cd-close" type="button" aria-label="Step back">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div class="cd-scroll">
      <div class="cd-tomb"></div>
      <div class="cd-more"></div>
    </div>
    <div class="cd-foot">
      <button class="cd-prev" type="button"><span aria-hidden="true">←</span> Previous</button>
      <span class="cd-count tnum"></span>
      <button class="cd-next" type="button">Next <span aria-hidden="true">→</span></button>
    </div>
  </aside>

  <TabBar items={tabs} spy={false} class="gw-tabs" />
</Base>

<script>
  import { initWall } from '@/concepts/scrapbook-gallery/wall';
  initWall();
</script>
