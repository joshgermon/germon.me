---
/**
 * A role as an Apple Wallet pass (generic pass layout): logo + header field,
 * a primary field, secondary and auxiliary field rows, and — on the full
 * pass in the detail sheet — a footer. Each pass wears its company's real
 * branding (colours and logo from their sites).
 */
import type { Role } from '@/data/profile';
import { brandOf } from './brands';

interface Props {
  role: Role;
  index: number;
  full?: boolean;
  class?: string;
}
const { role, full = false, class: cls } = Astro.props;
const b = brandOf(role.company);
const current = role.end === 'Present';
---
<div
  class:list={['card', 'wpass', `wpass--${b.key}`, { 'wpass--full': full }, cls]}
  style={`--pb:${b.bg};--pf:${b.fg};--pl:${b.label}`}
>
  <div class="p-head">
    {b.logo ? (
      <img class="p-logo" src={b.logo} alt={role.company} style={`height:${b.logoH}px`} loading="lazy" decoding="async" />
    ) : (
      <span class="p-word"><img src={b.avatar} alt="" width="26" height="26" loading="lazy" />{role.company}</span>
    )}
    <span class="p-hf">
      <span class="p-l">{current ? 'Status' : 'Until'}</span>
      <span class="p-v">{current ? <><i class="p-dot"></i>Current</> : role.end}</span>
    </span>
  </div>
  <div class="p-primary">
    <span class="p-pf">
      <span class="p-l">Role</span>
      <span class="p-title">{role.title}</span>
    </span>
    {b.mark && <img class="p-thumb" src={b.mark} alt="" loading="lazy" decoding="async" />}
  </div>
  <div class="p-fields">
    <span><span class="p-l">Company</span><span class="p-v">{role.company}{role.formerly && <em> · ex-{role.formerly}</em>}</span></span>
    <span><span class="p-l">Type</span><span class="p-v">{role.kind}</span></span>
  </div>
  <div class="p-fields p-aux">
    <span><span class="p-l">From</span><span class="p-v">{role.start}</span></span>
    <span><span class="p-l">Until</span><span class="p-v">{current ? 'Now' : role.end}</span></span>
    <span><span class="p-l">City</span><span class="p-v">Sydney</span></span>
  </div>
  {full && (
    <div class="p-foot">
      <span><span class="p-l">Stack</span><span class="p-v">{role.stack.join(' · ')}</span></span>
      <span class="p-site">{b.site}</span>
    </div>
  )}
  <i class="card-sheen" aria-hidden="true"></i>
</div>
