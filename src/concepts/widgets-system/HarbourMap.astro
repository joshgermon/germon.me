---
/** A hand-drawn, Apple-Maps-flavoured sketch of Sydney Harbour. Not to scale; to taste. */
interface Props { class?: string; labels?: boolean }
const { class: cls, labels = false } = Astro.props;
const uid = labels ? 'hm-l' : 'hm-s';
---
<svg class={cls} viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <clipPath id={`${uid}-cbd`}><path d="M66,112 C74,120 78,112 86,110 C94,108 100,118 112,118 L120,200 L60,200 Z" /></clipPath>
    <pattern id={`${uid}-grid`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-12)">
      <path d="M0 0H7M0 0V7" stroke="#fff" stroke-width="1.1" />
    </pattern>
  </defs>
  <rect width="200" height="200" fill="#f0ede6" />
  <!-- parks -->
  <ellipse cx="150" cy="168" rx="26" ry="18" fill="#cfe5b9" />
  <path d="M96,118 C104,116 112,122 114,130 C110,136 100,136 96,130 Z" fill="#cfe5b9" />
  <rect x="84" y="146" width="9" height="14" rx="2" fill="#cfe5b9" transform="rotate(-12 88 153)" />
  <ellipse cx="34" cy="54" rx="18" ry="11" fill="#d7e9c4" />
  <ellipse cx="120" cy="34" rx="14" ry="20" fill="#d7e9c4" />
  <!-- CBD street grid -->
  <rect width="200" height="200" fill={`url(#${uid}-grid)`} clip-path={`url(#${uid}-cbd)`} opacity="0.9" />
  <!-- water -->
  <path
    fill="#a6d3f2"
    d="M0,88 C20,86 34,92 50,88 C60,85 66,78 76,80 C86,82 90,74 100,72 C112,70 118,78 130,76 C140,74 146,64 152,56 C156,44 152,30 158,18 C162,10 170,12 168,24 C166,38 166,52 172,62 C178,70 190,66 200,62 L200,118 C190,116 182,124 172,122 C164,120 160,112 150,112 C140,112 136,124 126,122 C116,120 112,106 102,106 C94,106 92,110 86,110 C80,110 78,120 76,132 C74,142 70,146 66,142 C62,136 66,124 64,114 C62,104 54,100 46,102 C34,104 22,98 0,102 Z"
  />
  <!-- roads -->
  <g fill="none" stroke-linecap="round">
    <path d="M0,150 C40,140 60,160 100,150 S160,134 200,142" stroke="#dcd7cc" stroke-width="4" />
    <path d="M0,150 C40,140 60,160 100,150 S160,134 200,142" stroke="#fff" stroke-width="2.4" />
    <path d="M0,40 C30,46 60,30 100,38 S150,52 200,40" stroke="#dcd7cc" stroke-width="4" />
    <path d="M0,40 C30,46 60,30 100,38 S150,52 200,40" stroke="#fff" stroke-width="2.4" />
    <path d="M120,200 C126,170 134,150 170,128" stroke="#fff" stroke-width="2" />
    <!-- highway + bridge -->
    <path d="M86,200 C84,170 84,140 83,112 L81,80 C80,56 88,30 92,0" stroke="#e0a63e" stroke-width="4.6" />
    <path d="M86,200 C84,170 84,140 83,112 L81,80 C80,56 88,30 92,0" stroke="#f8cf6b" stroke-width="3" />
    <path d="M77,82 Q82,92 87,82" stroke="#8a8f99" stroke-width="1" opacity="0.7" />
  </g>
  {labels && (
    <g font-family="system-ui, -apple-system, sans-serif" font-weight="600" fill="#6e6a62" font-size="5.2" letter-spacing="0.4">
      <text x="24" y="70">NORTH SYDNEY</text>
      <text x="100" y="178">SURRY HILLS</text>
      <text x="166" y="96" fill="#4f88b8" font-style="italic" font-weight="500">Port Jackson</text>
      <text x="150" y="186" font-size="4.6">Centennial Park</text>
    </g>
  )}
  <!-- you are here -->
  <g class="hm-pin" transform="translate(91 131)">
    <circle r="15" fill="#0a84ff" opacity="0.16" class="hm-halo" />
    <circle r="6.6" fill="#fff" />
    <circle r="4.6" fill="#0a84ff" />
  </g>
</svg>
