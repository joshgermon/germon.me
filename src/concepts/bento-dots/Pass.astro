---
/**
 * A role as a Wallet pass, adapted for the bento: same real employer branding
 * (colour + logo) as the System concept, but a quieter layout — logo and
 * status on the strip, the title, then dates. The `full` pass (detail sheet)
 * adds company, type, stack and the company's site.
 */
import type { Role } from '@/data/profile';
import { brandOf } from '@/concepts/widgets-system/brands';

interface Props {
  role: Role;
  full?: boolean;
}
const { role, full = false } = Astro.props;
const b = brandOf(role.company);
const current = role.end === 'Present';
const yr = (s: string) => s.split(' ')[1];
---
<div class:list={['bp', `bp--${b.key}`, { 'bp--full': full }]} style={`--pb:${b.bg};--pf:${b.fg};--pl:${b.label}`}>
  <div class="bp-head">
    {b.logo ? (
      <img class="bp-logo" src={b.logo} alt={role.company} style={`height:${Math.round(b.logoH * 0.86)}px`} loading="lazy" decoding="async" />
    ) : (
      <span class="bp-word"><img src={b.avatar} alt="" width="22" height="22" loading="lazy" />{role.company}</span>
    )}
    <span class="bp-when">
      {current ? <><i class="bp-dot"></i>Now</> : `${yr(role.start)}–${yr(role.end)}`}
    </span>
  </div>
  <div class="bp-primary">
    <span class="bp-l">Role</span>
    <span class="bp-title">{role.title}</span>
  </div>
  <div class="bp-fields bp-co">
    <span><span class="bp-l">Company</span><span class="bp-v">{role.company}{role.formerly && <em> · ex-{role.formerly}</em>}</span></span>
    <span><span class="bp-l">Type</span><span class="bp-v">{role.kind}</span></span>
  </div>
  <div class="bp-fields bp-aux">
    <span><span class="bp-l">From</span><span class="bp-v">{role.start}</span></span>
    <span><span class="bp-l">Until</span><span class="bp-v">{current ? 'Now' : role.end}</span></span>
    <span><span class="bp-l">City</span><span class="bp-v">Sydney</span></span>
  </div>
  {full && (
    <div class="bp-foot">
      <span><span class="bp-l">Stack</span><span class="bp-v bp-v--wrap">{role.stack.join(' · ')}</span></span>
      <span class="bp-site">{b.site}</span>
    </div>
  )}
  <i class="bp-sheen" aria-hidden="true"></i>
</div>
