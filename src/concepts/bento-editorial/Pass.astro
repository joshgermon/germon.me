---
/**
 * A role as a Wallet pass, adapted for the editorial page: the company's own
 * colour and logo, one primary field, two quiet aux fields. No CV detail.
 */
import type { Role } from '@/data/profile';
import { brandOf } from '@/concepts/widgets-system/brands';

interface Props {
  role: Role;
  mini?: boolean;
  class?: string;
}
const { role, mini = false, class: cls } = Astro.props;
const b = brandOf(role.company);
const current = role.end === 'Present';
---
<div class:list={['pass', `pass--${b.key}`, { 'pass--mini': mini }, cls]} style={`--pb:${b.bg};--pf:${b.fg};--pl:${b.label}`}>
  <div class="pass-head">
    {b.logo ? (
      <img class="pass-logo" src={b.logo} alt={role.company} style={`height:${b.logoH * (mini ? 0.78 : 0.9)}px`} loading="lazy" decoding="async" />
    ) : (
      <span class="pass-word"><img src={b.avatar} alt="" width="22" height="22" loading="lazy" />{role.company}</span>
    )}
    <span class="pass-hf">
      <span class="pass-l">{current ? 'Status' : 'Until'}</span>
      <span class="pass-v">{current ? <><i class="pass-dot"></i>Current</> : role.end.split(' ')[1]}</span>
    </span>
  </div>
  <div class="pass-primary">
    <span class="pass-l">Role</span>
    <span class="pass-title">{role.title}</span>
  </div>
  <div class="pass-aux">
    <span><span class="pass-l">From</span><span class="pass-v">{role.start}</span></span>
    <span><span class="pass-l">Type</span><span class="pass-v">{role.kind}</span></span>
    {b.mark && <img class="pass-mark" src={b.mark} alt="" loading="lazy" decoding="async" />}
  </div>
</div>
