---
/**
 * A role as a Wallet pass, in Raycast's clothes: flat brand colour, hairline
 * inner edge, small precise type. `full` adds the auxiliary row + footer.
 */
import type { Role } from '@/data/profile';
import { brandOf } from '@/concepts/widgets-system/brands';

interface Props {
  role: Role;
  full?: boolean;
  class?: string;
}
const { role, full = false, class: cls } = Astro.props;
const b = brandOf(role.company);
const current = role.end === 'Present';
---
<div class:list={['bp', `bp--${b.key}`, { 'bp--full': full }, cls]} style={`--pb:${b.bg};--pf:${b.fg};--pl:${b.label}`}>
  <div class="bp-head">
    {b.logo ? (
      <img class="bp-logo" src={b.logo} alt={role.company} style={`height:${Math.round(b.logoH * 0.82)}px`} loading="lazy" decoding="async" />
    ) : (
      <span class="bp-word"><img src={b.avatar} alt="" width="20" height="20" loading="lazy" />{role.company}</span>
    )}
    <span class="bp-hf">
      <span class="bp-l">{current ? 'Status' : 'Years'}</span>
      <span class="bp-v">{current ? <><i class="bp-dot"></i>Current</> : `${role.start.split(' ')[1]}–${role.end.split(' ')[1]}`}</span>
    </span>
  </div>
  <div class="bp-primary">
    <span class="bp-l">Role</span>
    <span class="bp-title">{role.title}</span>
  </div>
  <div class="bp-fields">
    <span><span class="bp-l">Company</span><span class="bp-v">{role.company}{role.formerly && <em> · ex-{role.formerly}</em>}</span></span>
    <span><span class="bp-l">Type</span><span class="bp-v">{role.kind}</span></span>
    {full && <span><span class="bp-l">City</span><span class="bp-v">Sydney</span></span>}
  </div>
  {full && (
    <div class="bp-foot">
      <span><span class="bp-l">From</span><span class="bp-v">{role.start}</span></span>
      <span><span class="bp-l">Until</span><span class="bp-v">{current ? 'Now' : role.end}</span></span>
      <span class="bp-site">{b.site}</span>
    </div>
  )}
</div>
