---
/** Small objects standing on the floating shelf — one stand-in per side project. */
interface Props {
  kind: 'tape' | 'box' | 'sign' | 'books' | 'hourglass' | 'bell';
}
const { kind } = Astro.props;
---
{kind === 'tape' && (
  <svg class="obj-svg" viewBox="0 0 132 124" width="132" height="124" aria-hidden="true">
    <defs>
      <linearGradient id="tp-b" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3b3a39" /><stop offset=".06" stop-color="#2b2a29" /><stop offset="1" stop-color="#171615" />
      </linearGradient>
      <linearGradient id="tp-w" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2a2a2a" /><stop offset="1" stop-color="#0b0b0b" />
      </linearGradient>
    </defs>
    <rect x=".5" y=".5" width="131" height="123" rx="5" fill="url(#tp-b)" stroke="#000" stroke-opacity=".55" />
    <path d="M5 1.6h122" stroke="#fff" stroke-opacity=".22" />
    <g fill="#111" opacity=".85">
      {Array.from({ length: 7 }, (_, i) => <rect x={8 + i * 4} y="62" width="1.6" height="52" rx=".8" />)}
    </g>
    <rect x="44" y="14" width="66" height="36" rx="3" fill="url(#tp-w)" />
    <circle cx="77" cy="32" r="13" fill="#1d1c1b" stroke="#000" stroke-opacity=".6" />
    <circle cx="77" cy="32" r="4" fill="#0e0e0e" />
    <path d="M46 16h62" stroke="#fff" stroke-opacity=".12" />
    <rect x="114" y="12" width="9" height="15" rx="1.2" fill="#7b2a22" />
    <rect x="42" y="62" width="80" height="48" rx="1.5" fill="#f3f0e8" />
    <g fill="#1d1c1a">
      {[0, 3, 5, 9, 11, 12, 16, 19, 21, 24, 27, 28, 31, 35, 37, 40, 43, 44, 48, 51, 53, 56, 59, 60, 64, 67].map((x, i) => (
        <rect x={48 + x} y="66" width={i % 3 === 0 ? 2 : 1} height="22" />
      ))}
    </g>
    <text x="48" y="101" font-family="Geist Mono Variable, monospace" font-size="9.5" font-weight="500" fill="#1d1c1a" letter-spacing=".6">BKSD01L9</text>
  </svg>
)}

{kind === 'box' && (
  <svg class="obj-svg" viewBox="0 0 184 112" width="184" height="112" aria-hidden="true">
    <defs>
      <linearGradient id="bx-f" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#c9a173" /><stop offset="1" stop-color="#a87d4e" />
      </linearGradient>
      <linearGradient id="bx-l" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#dcb688" /><stop offset=".3" stop-color="#c79e6e" /><stop offset="1" stop-color="#9e7446" />
      </linearGradient>
      <linearGradient id="bx-p" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e3cf9a" /><stop offset="1" stop-color="#a88a4c" />
      </linearGradient>
    </defs>
    <path d="M8 40 L176 40 L176 44 L8 44 Z" fill="#2a1d12" />
    <path d="M6 38 L8 22 L178 33 L178 41 Z" fill="#3b2817" />
    <rect x="6" y="42" width="172" height="70" fill="url(#bx-f)" />
    <g stroke="#7a5430" stroke-opacity=".28" fill="none" stroke-width="1">
      <path d="M6 56 C50 54 90 60 178 55" /><path d="M6 71 C60 69 110 75 178 70" /><path d="M6 88 C40 86 120 92 178 86" />
      <path d="M6 100 C70 98 120 104 178 99" /><path d="M60 62 c10 -4 22 -4 30 0 c-8 5 -20 5 -30 0z" />
    </g>
    <path d="M6 42 H178" stroke="#fff" stroke-opacity=".25" />
    <g transform="rotate(-4.2 178 34)">
      <rect x="2" y="20" width="180" height="16" rx="1.5" fill="url(#bx-l)" />
      <path d="M3 21 H181" stroke="#fff" stroke-opacity=".35" />
      <g stroke="#7a5430" stroke-opacity=".3"><path d="M2 27 C60 26 120 30 182 27" fill="none" /></g>
    </g>
    <rect x="72" y="66" width="40" height="16" rx="1" fill="url(#bx-p)" stroke="#6b5426" stroke-opacity=".5" />
    <text x="92" y="77.5" text-anchor="middle" font-family="Inter Variable, sans-serif" font-size="7.5" font-weight="600" letter-spacing="1.6" fill="#4a3815">CUBBY</text>
  </svg>
)}

{kind === 'sign' && (
  <svg class="obj-svg" viewBox="0 0 156 112" width="156" height="112" aria-hidden="true">
    <defs>
      <linearGradient id="sg-e" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fbfaf6" /><stop offset="1" stop-color="#e6e2d8" />
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="154" height="110" rx="10" fill="url(#sg-e)" stroke="#000" stroke-opacity=".18" />
    <rect x="8" y="8" width="140" height="96" rx="6" fill="none" stroke="#1d2530" stroke-width="3" />
    <circle cx="16" cy="16" r="3" fill="#cfcac0" stroke="#8d877b" stroke-width=".8" />
    <circle cx="140" cy="16" r="3" fill="#cfcac0" stroke="#8d877b" stroke-width=".8" />
    <text x="78" y="44" text-anchor="middle" font-family="Geist Mono Variable, monospace" font-size="12" font-weight="500" letter-spacing="1.5" fill="#1d2530">HTTP/1.1</text>
    <text x="78" y="82" text-anchor="middle" font-family="Inter Variable, sans-serif" font-size="36" font-weight="700" letter-spacing="-.5" fill="#1d2530">200 OK</text>
    <path d="M12 3 H144" stroke="#fff" stroke-opacity=".9" />
  </svg>
)}

{kind === 'books' && (
  <svg class="obj-svg" viewBox="0 0 230 200" width="230" height="200" aria-hidden="true">
    <defs>
      <linearGradient id="bk-a" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#6e332d" /><stop offset=".45" stop-color="#5a2823" /><stop offset="1" stop-color="#3d1a17" />
      </linearGradient>
      <linearGradient id="bk-b" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e9e4d8" /><stop offset="1" stop-color="#bdb6a6" />
      </linearGradient>
      <linearGradient id="bk-c" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#1f2a24" /><stop offset=".35" stop-color="#34443a" /><stop offset=".7" stop-color="#2a372f" /><stop offset="1" stop-color="#151d18" />
      </linearGradient>
    </defs>
    <!-- lying stack -->
    <rect x="6" y="168" width="176" height="32" rx="2" fill="url(#bk-a)" />
    <path d="M8 169.5 H180" stroke="#fff" stroke-opacity=".18" />
    <text x="94" y="189" text-anchor="middle" font-family="Newsreader Variable, serif" font-size="12" font-style="italic" fill="#d4b77c" letter-spacing=".4">Writing an Interpreter</text>
    <rect x="14" y="142" width="160" height="26" rx="2" fill="url(#bk-b)" />
    <path d="M16 143.5 H172" stroke="#fff" stroke-opacity=".7" />
    <text x="94" y="159" text-anchor="middle" font-family="Inter Variable, sans-serif" font-size="8" font-weight="600" letter-spacing="2.2" fill="#2b2925">LEXER · PARSER · EVAL</text>
    <!-- standing book -->
    <rect x="188" y="8" width="38" height="192" rx="3" fill="url(#bk-c)" />
    <rect x="188" y="18" width="38" height="2" fill="#c9ad72" opacity=".9" />
    <rect x="188" y="186" width="38" height="2" fill="#c9ad72" opacity=".9" />
    <text transform="translate(212 104) rotate(90)" text-anchor="middle" font-family="Newsreader Variable, serif" font-size="15" letter-spacing="3" fill="#d4b77c">MONKEY</text>
  </svg>
)}

{kind === 'hourglass' && (
  <svg class="obj-svg" viewBox="0 0 100 176" width="100" height="176" aria-hidden="true">
    <defs>
      <linearGradient id="hg-w" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#7a5236" /><stop offset=".5" stop-color="#5b3b25" /><stop offset="1" stop-color="#3e2716" />
      </linearGradient>
      <linearGradient id="hg-g" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity=".42" /><stop offset=".25" stop-color="#fff" stop-opacity=".1" />
        <stop offset=".75" stop-color="#fff" stop-opacity=".06" /><stop offset="1" stop-color="#fff" stop-opacity=".3" />
      </linearGradient>
    </defs>
    <rect x="9" y="14" width="5" height="148" fill="url(#hg-w)" />
    <rect x="86" y="14" width="5" height="148" fill="url(#hg-w)" />
    <path d="M27 16 C27 60 46 70 48 88 C46 106 27 116 27 160 L73 160 C73 116 54 106 52 88 C54 70 73 60 73 16 Z" fill="url(#hg-g)" stroke="#6d6a63" stroke-opacity=".5" stroke-width=".8" />
    <path d="M33 42 L67 42 C65 62 54 72 50 84 C46 72 35 62 33 42 Z" fill="#d6c39a" />
    <path d="M49.4 84 V150" stroke="#d6c39a" stroke-width="1.2" />
    <path d="M30 160 C38 136 44 130 50 128 C56 130 62 136 70 160 Z" fill="#cdb88c" />
    <path d="M31 20 C31 52 40 64 44 76" stroke="#fff" stroke-opacity=".75" stroke-width="1.6" fill="none" stroke-linecap="round" />
    <path d="M31 156 C31 128 38 112 44 102" stroke="#fff" stroke-opacity=".55" stroke-width="1.4" fill="none" stroke-linecap="round" />
    <rect x="1" y="2" width="98" height="14" rx="3" fill="url(#hg-w)" />
    <rect x="1" y="160" width="98" height="16" rx="3" fill="url(#hg-w)" />
    <path d="M4 3.5 H96 M4 161.5 H96" stroke="#fff" stroke-opacity=".22" />
  </svg>
)}

{kind === 'bell' && (
  <svg class="obj-svg" viewBox="0 0 132 106" width="132" height="106" aria-hidden="true">
    <defs>
      <radialGradient id="bl-d" cx=".34" cy=".28" r=".85">
        <stop offset="0" stop-color="#fbeab7" /><stop offset=".18" stop-color="#e4c071" /><stop offset=".55" stop-color="#b48a35" /><stop offset="1" stop-color="#5e4416" />
      </radialGradient>
      <linearGradient id="bl-r" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#6e5219" /><stop offset=".3" stop-color="#d9b562" /><stop offset=".6" stop-color="#9a7429" /><stop offset="1" stop-color="#5a4114" />
      </linearGradient>
      <linearGradient id="bl-b" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2e2c2a" /><stop offset="1" stop-color="#0f0e0d" />
      </linearGradient>
    </defs>
    <rect x="4" y="86" width="124" height="20" rx="4" fill="url(#bl-b)" />
    <path d="M8 87.5 H124" stroke="#fff" stroke-opacity=".18" />
    <rect x="58" y="8" width="16" height="22" rx="2" fill="url(#bl-r)" />
    <ellipse cx="66" cy="9" rx="10" ry="6" fill="url(#bl-d)" />
    <path d="M14 84 C14 44 40 26 66 26 C92 26 118 44 118 84 Z" fill="url(#bl-d)" />
    <rect x="10" y="80" width="112" height="7" rx="2" fill="url(#bl-r)" />
    <path d="M30 56 C36 42 48 34 60 32" stroke="#fff" stroke-opacity=".6" stroke-width="2.5" fill="none" stroke-linecap="round" />
  </svg>
)}
