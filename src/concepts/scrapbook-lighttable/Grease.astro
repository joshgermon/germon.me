---
/**
 * A red china-marker circle, drawn as strokes (never a font). Two passes of a
 * loose, overshooting ellipse; the waxy drag texture comes from #lt-wax.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['grease', cls]} viewBox="0 0 260 190" fill="none" aria-hidden="true">
  <g filter="url(#lt-wax)" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path
      stroke-width="7"
      d="M58 46C92 22 168 16 214 40c34 18 40 66 14 98-28 34-104 46-160 30C24 156 10 118 22 86c10-26 40-44 86-52 26-4 52-4 70 0"
    />
    <path
      stroke-width="4.5"
      opacity="0.85"
      d="M200 30c26 10 44 34 40 64-4 34-40 58-92 64-52 6-108-8-122-46"
    />
  </g>
</svg>
