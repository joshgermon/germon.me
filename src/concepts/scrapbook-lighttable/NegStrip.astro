---
/**
 * A strip of developed 35mm colour negative: orange base, sprocket holes the
 * light shines through, latent edge print (stock name, frame numbers, DX
 * barcode) and inverted frames. `fav` gets the red grease-pencil circle.
 */
import Grease from './Grease.astro';
interface Props {
  frames: { src: string; alt: string }[];
  start?: number;
  fav?: number;
  class?: string;
}
const { frames, start = 14, fav = -1, class: cls } = Astro.props;
// Deterministic DX-ish barcode: two rows of short bars per frame.
const bars = (seed: number) => {
  const out: { x: number; row: number }[] = [];
  let s = seed * 9301 + 49297;
  for (let i = 0; i < 22; i++) {
    s = (s * 9301 + 49297) % 233280;
    if (s / 233280 > 0.45) out.push({ x: i * 3.2, row: 0 });
    s = (s * 9301 + 49297) % 233280;
    if (s / 233280 > 0.35) out.push({ x: i * 3.2, row: 1 });
  }
  return out;
};
---
<div class:list={['neg', cls]} style={`--n:${frames.length}`}>
  <div class="neg-print neg-print-top" aria-hidden="true">
    {frames.map((_, i) => (
      <span class="np-cell">{i % 2 === 0 ? 'KODAK PORTRA 400' : ''}<b>{i % 2 === 0 ? '5' : ''}</b></span>
    ))}
  </div>
  <div class="neg-holes" aria-hidden="true"></div>
  <div class="neg-frames">
    {frames.map((f, i) => (
      <div class:list={['neg-frame', i === fav && 'is-fav']}>
        <img src={f.src} alt={`${f.alt} (negative)`} loading="eager" decoding="async" draggable="false" crossorigin="anonymous" />
        {i === fav && <Grease class="neg-circle" />}
      </div>
    ))}
  </div>
  <div class="neg-holes" aria-hidden="true"></div>
  <div class="neg-print neg-print-bottom" aria-hidden="true">
    {frames.map((_, i) => (
      <span class="np-cell">
        <span class="np-num">{start + i}</span>
        <svg class="np-dx" viewBox="0 0 72 8" width="72" height="8">
          {bars(start + i).map((b) => <rect x={b.x} y={b.row * 4.2} width="1.6" height="3.4" />)}
        </svg>
        <span class="np-num">▸{start + i}A</span>
      </span>
    ))}
  </div>
</div>
